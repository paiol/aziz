@model ComparacaoPropostas.Models.Entities.Processo
@{
    ViewData["Title"] = "Novo Processo";
}

<h2>Novo Processo</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TipoProcesso" class="form-label"></label>
                    <input asp-for="TipoProcesso" class="form-control" placeholder="Ex: Equipamentos e Materiais" />
                    <span asp-validation-for="TipoProcesso" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Descricao" class="form-label"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-md-4">
                    <label asp-for="PrazoFinal" class="form-label"></label>
                    <input asp-for="PrazoFinal" class="form-control" type="date" />
                </div>
                <div class="col-md-4">
                    <label asp-for="OrcamentoEstimado" class="form-label"></label>
                    <input asp-for="OrcamentoEstimado" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label asp-for="CriadoPor" class="form-label"></label>
                    <input asp-for="CriadoPor" class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="EmailsNotificacao" class="form-label"></label>
                    <input asp-for="EmailsNotificacao" class="form-control" placeholder="email1@exemplo.com, email2@exemplo.com" />
                    <div class="form-text">Separe vários e-mails por vírgula. Recebem a classificação final quando o processo é marcado como Decidido.</div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-subtle-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
