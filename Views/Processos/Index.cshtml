@using ComparacaoPropostas.Helper
@model List<ComparacaoPropostas.ViewModels.Processos.ProcessoIndexVM>
@{
    ViewData["Title"] = "Processos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Processos</h2>
    <a class="btn btn-primary" asp-action="Create"><span class="fas fa-plus me-1"></span> Novo Processo</a>
</div>

@if (Model.Count > 0)
{
    var estados = Enum.GetValues<ComparacaoPropostas.Models.Entities.Enums.StatusProcesso>();
    var porArea = Model.Where(p => p.ValorAdjudicadoCVE.HasValue && p.Status != ComparacaoPropostas.Models.Entities.Enums.StatusProcesso.Cancelado)
        .GroupBy(p => p.Area).OrderBy(g => g.Key).ToList();
    <div class="row g-3 mb-3">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header py-2"><h6 class="mb-0">Processos por estado</h6></div>
                <div class="card-body" style="height: 220px">
                    <canvas class="js-grafico" data-grafico="@GraficoHelper.Circular(estados.Select(s => s.ToLabel()), estados.Select(s => (decimal)Model.Count(p => p.Status == s)))"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header py-2"><h6 class="mb-0">Adjudicado por área (CVE)</h6></div>
                <div class="card-body" style="height: 220px">
                    <canvas class="js-grafico" data-moeda="cve" data-grafico="@GraficoHelper.Barras(porArea.Select(g => g.Key.ToLabel()), "Adjudicado", porArea.Select(g => g.Sum(p => p.ValorAdjudicadoCVE ?? 0)))"></canvas>
                </div>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        <table class="table table-hover data-table">
            <thead>
                <tr>
                    <th>Nº Processo</th>
                    <th>Nome</th>
                    <th>Projeto Capex</th>
                    <th>Tipo Proposta</th>
                    <th>Área</th>
                    <th>Qtd. Fornecedores</th>
                    <th>Estado</th>
                    <th>Prazo Final</th>
                    <th>Orçamento Estimado</th>
                    <th>Propostas</th>
                    <th>Menor Valor</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(p.NumeroProcesso) ? "-" : p.NumeroProcesso)</td>
                        <td><a asp-action="Details" asp-route-id="@p.Id">@p.Nome</a></td>
                        <td>@if (p.ProjetoCapexId.HasValue) { <a asp-controller="ProjetosPlano" asp-action="Details" asp-route-id="@p.ProjetoCapexId">@p.ProjetoCapex</a> } else { <span class="text-body-tertiary">-</span> }</td>
                        <td>@p.TipoProposta</td>
                        <td>@p.Area.ToLabel()</td>
                        <td>@p.TotalFornecedores</td>
                        <td>
                            <span class="@p.ToBadgeClassComAlerta()">@p.Status.ToLabel()</span>
                            @if (p.TemAlertaDePrazo())
                            {
                                <i class="fas fa-triangle-exclamation text-danger ms-1" title="@p.MensagemAlertaDePrazo()"></i>
                            }
                        </td>
                        <td>@(p.PrazoEntrega?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@(p.OrcamentoEstimado?.ToString("C") ?? "-")</td>
                        <td>@p.TotalPropostas</td>
                        <td>@(p.MenorValorOfertado?.ToString("C") ?? "-")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-subtle-secondary" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                            <button type="button" class="btn btn-sm btn-subtle-danger js-delete-btn"
                                    data-url="@Url.Action("Delete", new { id = p.Id })" data-id="@p.Id">
                                Apagar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
