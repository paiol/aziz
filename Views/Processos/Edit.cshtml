@using ComparacaoPropostas.Helper
@model ComparacaoPropostas.Models.Entities.Processo
@{
    ViewData["Title"] = "Editar Processo";
}

<h2>Editar Processo</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PedidoPropostaId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="alert alert-light border mb-3">
                Pedido de Proposta de origem: <strong>@Model.PedidoProposta.TipoProposta — @Model.PedidoProposta.Area.ToLabel()</strong> (não editável)
            </div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Fornecedor" class="form-label"></label>
                    <input asp-for="Fornecedor" class="form-control" />
                    <span asp-validation-for="Fornecedor" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Descricao" class="form-label"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ComparacaoPropostas.Models.Entities.Enums.StatusProcesso>()"></select>
                </div>

                <div class="col-md-6">
                    <label asp-for="CriadoPor" class="form-label"></label>
                    <input asp-for="CriadoPor" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="EmailsNotificacao" class="form-label"></label>
                    <input asp-for="EmailsNotificacao" class="form-control" />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-subtle-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
