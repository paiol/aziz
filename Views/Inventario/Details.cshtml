@using ComparacaoPropostas.Helper
@using ComparacaoPropostas.Models.Entities
@model ComparacaoPropostas.Models.Entities.InventarioStock
@{
    var inv = Model;
    ViewData["Title"] = $"Inventário {inv.Data:dd/MM/yyyy}";
    var saldos = (Dictionary<string, decimal>)ViewBag.Saldos;
    var aberto = inv.Estado == EstadoInventario.Aberto;
    decimal Sistema(LinhaInventario l) => aberto ? saldos.GetValueOrDefault(l.Codigo) : l.QuantidadeSistema ?? 0m;
    var linhas = inv.Linhas.OrderBy(l => l.Descricao ?? l.Codigo).ToList();
    var comDiferenca = linhas.Count(l => l.QuantidadeContada != null && l.QuantidadeContada != Sistema(l));
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Inventário @inv.Data.ToString("dd/MM/yyyy") · @inv.Area.ToLabel()</h2>
        <span class="badge @(aberto ? "bg-warning text-dark" : "bg-success")">@(aberto ? "Aberto" : "Fechado")</span>
        <span class="text-body-tertiary ms-1">@(inv.Localizacao ?? "") @(inv.Descricao != null ? "· " + inv.Descricao : "") @(inv.Responsavel != null ? "· " + inv.Responsavel : "")</span>
        <div><a asp-action="Index" class="small"><span class="fas fa-arrow-left me-1"></span>Voltar aos inventários</a></div>
    </div>
    @if (aberto)
    {
        <div class="d-flex gap-2">
            <form asp-action="Fechar" asp-route-id="@inv.Id" method="post"
                  onsubmit="return confirm('Fechar o inventário? O stock da área @inv.Area.ToLabel() passa a ser o contado (@comDiferenca material(is) com diferença) e não pode ser alterado depois.');">
                <button type="submit" class="btn btn-success"><span class="fas fa-lock me-1"></span> Fechar inventário</button>
            </form>
            <button type="button" class="btn btn-subtle-danger js-delete-btn" data-url="@Url.Action("Delete", new { id = inv.Id })" data-id="@inv.Id"><i class="fas fa-trash"></i></button>
        </div>
    }
    else
    {
        <span class="text-body-tertiary small">Fechado em @inv.FechadoEm?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
    }
</div>

@if (aberto)
{
    <div class="card mb-3">
        <div class="card-body">
            <form asp-action="Importar" asp-route-id="@inv.Id" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-end">
                <div>
                    <label for="ficheiro" class="form-label mb-1">Importar a contagem do armazém (.xls ou .xlsx)</label>
                    <input id="ficheiro" type="file" name="ficheiro" accept=".xls,.xlsx" class="form-control form-control-sm" required />
                </div>
                <button type="submit" class="btn btn-sm btn-subtle-primary"><span class="fas fa-upload me-1"></span> Importar</button>
            </form>
            <div class="form-text">Colunas reconhecidas: código / part number, descrição, unidade, quantidade (contada / existência / stock) e nº de série. Linhas com o mesmo código são somadas; uma linha por equipamento com nº de série conta 1.</div>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0">Contagem (@linhas.Count(l => l.QuantidadeContada != null) de @linhas.Count contadas · @comDiferenca com diferença)</h5>
    </div>
    <div class="card-body table-responsive">
        <form asp-action="GuardarContagem" asp-route-id="@inv.Id" method="post" id="form-contagem">
            <table class="table table-sm align-middle mb-2">
                <thead>
                    <tr><th>Código</th><th>Descrição</th><th>Un.</th><th class="text-end">Sistema</th><th class="text-end" style="width: 8rem">Contado</th><th class="text-end">Diferença</th><th style="width: 22%">Nºs de série</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var l in linhas)
                    {
                        var sistema = Sistema(l);
                        var dif = l.QuantidadeContada is decimal c ? c - sistema : (decimal?)null;
                        <tr class="@(dif is decimal d && d != 0 ? "table-warning" : "")">
                            <td class="text-nowrap">@if (l.MaterialStockId != null) { <a asp-controller="Stock" asp-action="Material" asp-route-id="@l.MaterialStockId">@l.Codigo</a> } else { @l.Codigo <span class="badge bg-info text-dark ms-1" title="Material novo: é criado ao fechar">novo</span> }</td>
                            <td class="small">@(l.Descricao ?? "-")</td>
                            <td>@(l.Unidade ?? "-")</td>
                            <td class="text-end">@sistema.ToQtd()</td>
                            <td class="text-end">
                                @if (aberto)
                                {
                                    <input name="contado_@l.Id" value="@l.QuantidadeContada?.ToString("0.###", new System.Globalization.CultureInfo("pt-PT"))" class="form-control form-control-sm text-end" inputmode="decimal" aria-label="Quantidade contada de @l.Codigo" />
                                }
                                else
                                {
                                    @(l.QuantidadeContada?.ToQtd() ?? "-")
                                }
                            </td>
                            <td class="text-end @(dif < 0 ? "text-danger" : dif > 0 ? "text-success" : "")">@(dif is decimal x ? (x > 0 ? "+" : "") + x.ToQtd() : "")</td>
                            <td>
                                @if (aberto)
                                {
                                    <input name="series_@l.Id" value="@l.Series" class="form-control form-control-sm font-monospace" aria-label="Números de série de @l.Codigo" />
                                }
                                else
                                {
                                    <span class="small font-monospace">@l.Series</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (aberto)
                                {
                                    <button type="submit" form="remover-@l.Id" class="btn btn-sm btn-subtle-danger" title="Remover linha"><i class="fas fa-xmark"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (aberto && linhas.Count > 0)
            {
                <button type="submit" class="btn btn-primary btn-sm"><span class="fas fa-save me-1"></span> Guardar contagem</button>
            }
        </form>
        @if (aberto)
        {
            @foreach (var l in linhas)
            {
                <form id="remover-@l.Id" asp-action="RemoverLinha" asp-route-id="@inv.Id" method="post" class="d-none"><input type="hidden" name="linhaId" value="@l.Id" /></form>
            }
        }
    </div>
</div>

@if (aberto)
{
    <div class="card">
        <div class="card-header py-2"><h6 class="mb-0">Acrescentar material à contagem</h6></div>
        <div class="card-body">
            <form asp-action="AdicionarLinha" asp-route-id="@inv.Id" method="post" class="row g-2 align-items-end">
                <div class="col-md-2"><label class="form-label mb-1" for="n-codigo">Código</label><input id="n-codigo" name="codigo" class="form-control form-control-sm" required maxlength="60" /></div>
                <div class="col-md-5"><label class="form-label mb-1" for="n-desc">Descrição</label><input id="n-desc" name="descricao" class="form-control form-control-sm" /></div>
                <div class="col-md-1"><label class="form-label mb-1" for="n-un">Un.</label><input id="n-un" name="unidade" class="form-control form-control-sm" maxlength="20" /></div>
                <div class="col-md-2"><label class="form-label mb-1" for="n-qtd">Contado</label><input id="n-qtd" name="contado" class="form-control form-control-sm text-end" inputmode="decimal" /></div>
                <div class="col-md-2"><button type="submit" class="btn btn-sm btn-subtle-primary w-100"><span class="fas fa-plus me-1"></span> Acrescentar</button></div>
            </form>
        </div>
    </div>
}
