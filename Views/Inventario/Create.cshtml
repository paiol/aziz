@using ComparacaoPropostas.Models.Entities.Enums
@model ComparacaoPropostas.Models.Entities.InventarioStock
@{
    ViewData["Title"] = "Novo inventário";
}

<h2>Novo inventário</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Area" class="form-label"></label>
                    <select asp-for="Area" class="form-select" asp-items="Html.GetEnumSelectList<AreaDepartamento>()"></select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Data" class="form-label"></label>
                    <input asp-for="Data" class="form-control" type="date" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Localizacao" class="form-label"></label>
                    <input asp-for="Localizacao" class="form-control" placeholder="ex.: Armazém Praia" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Descricao" class="form-label"></label>
                    <input asp-for="Descricao" class="form-control" placeholder="ex.: Inventário anual 2026" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Responsavel" class="form-label"></label>
                    <input asp-for="Responsavel" class="form-control" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="comStockAtual" name="comStockAtual" value="true" />
                        <label class="form-check-label" for="comStockAtual">Começar com os materiais que a plataforma tem em stock nesta área (para contar um a um)</label>
                    </div>
                    <div class="form-text">Sem esta opção, o inventário começa vazio e as linhas vêm do Excel da contagem do armazém.</div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><span class="fas fa-save me-1"></span> Criar inventário</button>
                <a asp-action="Index" class="btn btn-subtle-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
