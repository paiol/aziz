@using ComparacaoPropostas.Helper
@model ComparacaoPropostas.Models.Entities.Proposta
@{
    ViewData["Title"] = "Editar Proposta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Editar Proposta — @Model.Fornecedor</h2>
        <p class="text-body-tertiary mb-0">Processo: @ViewBag.ProcessoNome</p>
    </div>
    <div>
        <a class="btn btn-outline-primary" asp-controller="ItensProposta" asp-action="Index" asp-route-propostaId="@Model.Id">
            <span class="fas fa-boxes-stacked me-1"></span> Gerir Itens e Preços
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ProcessoId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Fornecedor" class="form-label"></label>
                            <input asp-for="Fornecedor" class="form-control" required />
                            <span asp-validation-for="Fornecedor" class="text-danger"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Moeda" class="form-label"></label>
                            <input type="text" class="form-control" value="@Model.Moeda" readonly />
                            <input type="hidden" asp-for="Moeda" />
                            <div class="form-text">Definida pelo tipo de compra do processo (@((ComparacaoPropostas.Models.Entities.Enums.TipoCompra)ViewBag.TipoCompra == ComparacaoPropostas.Models.Entities.Enums.TipoCompra.Internacional ? "Internacional" : "Nacional")).</div>
                        </div>

                        @* Taxa Câmbio — ocultada por agora; segue o valor padrão do processo.
                        <div class="col-md-3">
                            <label asp-for="TaxaCambio" class="form-label">Taxa Câmbio (EUR/CVE)</label>
                            <input asp-for="TaxaCambio" class="form-control" type="number" step="0.0001" min="0.0001" />
                            <span asp-validation-for="TaxaCambio" class="text-danger"></span>
                        </div>
                        *@
                        <input type="hidden" asp-for="TaxaCambio" />

                        <div class="col-md-4">
                            <label asp-for="PrazoEntregaDias" class="form-label">Prazo de Entrega (Dias)</label>
                            <input asp-for="PrazoEntregaDias" id="prazoEntregaDias" class="form-control" type="number" min="0" />
                            @if (ViewBag.DiasDisponiveis != null)
                            {
                                <div class="form-text">Prazo solicitado: @((int)ViewBag.DiasDisponiveis) dias (até @(((DateTime)ViewBag.PrazoSolicitadoData).ToString("dd/MM/yyyy"))).</div>
                                <div id="avisoPrazo" class="alert alert-warning mt-2 py-1 px-2 small d-none">
                                    <i class="fas fa-triangle-exclamation me-1"></i> O prazo indicado é maior do que o solicitado.
                                </div>
                            }
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Garantia" class="form-label"></label>
                            <input asp-for="Garantia" class="form-control" placeholder="ex.: 2 anos" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ValidadeProposta" class="form-label"></label>
                            <input asp-for="ValidadeProposta" class="form-control" type="date" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ComparacaoPropostas.Models.Entities.Enums.StatusProposta>()"></select>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Total Calculado dos Itens</label>
                            <div class="form-control bg-light">
                                <strong>@MoedaHelper.FormatarValor(Model.ValorTotal, Model.Moeda)</strong>
                                @if (string.Equals(Model.Moeda, MoedaHelper.MoedaEur, StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="text-muted ms-2">(@MoedaHelper.FormatarValor(Model.ValorTotalCVE, MoedaHelper.MoedaCve))</span>
                                }
                            </div>
                            <small class="text-muted">O valor total é recalculado automaticamente a partir dos itens incluídos na proposta.</small>
                        </div>

                        <div class="col-12">
                            <label asp-for="Observacoes" class="form-label"></label>
                            <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Guardar Alterações</button>
                        <a asp-controller="Processos" asp-action="Details" asp-route-id="@Model.ProcessoId" class="btn btn-subtle-secondary">Voltar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">Anexos</h5></div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var anexo in Model.Anexos)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a asp-controller="Anexos" asp-action="Download" asp-route-id="@anexo.Id">@anexo.NomeArquivo</a>
                            <button type="button" class="btn btn-sm btn-subtle-danger js-delete-btn"
                                    data-url="@Url.Action("Delete", "Anexos", new { id = anexo.Id })" data-id="@anexo.Id">
                                <span class="fas fa-trash"></span>
                            </button>
                        </li>
                    }
                    @if (Model.Anexos.Count == 0)
                    {
                        <li class="list-group-item text-body-tertiary">Sem anexos.</li>
                    }
                </ul>
                <form asp-controller="Anexos" asp-action="Upload" asp-route-propostaId="@Model.Id" method="post" enctype="multipart/form-data">
                    <input type="file" name="ficheiro" class="form-control mb-2" required />
                    <button type="submit" class="btn btn-sm btn-subtle-primary w-100">Enviar Anexo</button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.DiasDisponiveis != null)
{
    @section Scripts {
        <script>
            (function () {
                var limite = @((int)ViewBag.DiasDisponiveis);
                var input = document.getElementById('prazoEntregaDias');
                var aviso = document.getElementById('avisoPrazo');

                function verificar() {
                    var valor = parseInt(input.value, 10);
                    aviso.classList.toggle('d-none', !(valor > limite));
                }

                input.addEventListener('input', verificar);
                verificar();
            })();
        </script>
    }
}
