@model ComparacaoPropostas.Models.Entities.Proposta
@{
    ViewData["Title"] = "Editar Proposta";
}

<h2>Editar Proposta — @ViewBag.ProcessoNome</h2>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ProcessoId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Fornecedor" class="form-label"></label>
                            <input asp-for="Fornecedor" class="form-control" />
                            <span asp-validation-for="Fornecedor" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="ValorTotal" class="form-label"></label>
                            <input asp-for="ValorTotal" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PrazoEntregaDias" class="form-label"></label>
                            <input asp-for="PrazoEntregaDias" class="form-control" type="number" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ValidadeProposta" class="form-label"></label>
                            <input asp-for="ValidadeProposta" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ComparacaoPropostas.Models.Entities.Enums.StatusProposta>()"></select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Observacoes" class="form-label"></label>
                            <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-controller="Processos" asp-action="Details" asp-route-id="@Model.ProcessoId" class="btn btn-subtle-secondary">Voltar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">Anexos</h5></div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var anexo in Model.Anexos)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a asp-controller="Anexos" asp-action="Download" asp-route-id="@anexo.Id">@anexo.NomeArquivo</a>
                            <button type="button" class="btn btn-sm btn-subtle-danger js-delete-btn"
                                    data-url="@Url.Action("Delete", "Anexos", new { id = anexo.Id })" data-id="@anexo.Id">
                                <span class="fas fa-trash"></span>
                            </button>
                        </li>
                    }
                    @if (Model.Anexos.Count == 0)
                    {
                        <li class="list-group-item text-body-tertiary">Sem anexos.</li>
                    }
                </ul>
                <form asp-controller="Anexos" asp-action="Upload" asp-route-propostaId="@Model.Id" method="post" enctype="multipart/form-data">
                    <input type="file" name="ficheiro" class="form-control mb-2" required />
                    <button type="submit" class="btn btn-sm btn-subtle-primary w-100">Enviar Anexo</button>
                </form>
            </div>
        </div>
    </div>
</div>
