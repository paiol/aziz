@model ComparacaoPropostas.ViewModels.ProjetosObra.AdjudicacaoObraVM
@{
    ViewData["Title"] = "Adjudicação do Projeto";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Adjudicação do Projeto</h2>
        <p class="text-body-tertiary mb-0">@Model.ProjetoObraNome</p>
    </div>
    <a class="btn btn-subtle-secondary" asp-action="Details" asp-route-id="@Model.ProjetoObraId">Voltar aos Detalhes</a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header"><h5 class="mb-0">Ranking das Propostas e Seleção do Vencedor</h5></div>
            <div class="card-body">
                <form asp-action="Adjudicar" method="post" id="form-adjudicacao">
                    <input type="hidden" asp-for="ProjetoObraId" />
                    <input type="hidden" asp-for="ProjetoObraNome" />
                    <input type="hidden" asp-for="PrimeiroLugarRankingId" id="primeiro-lugar-id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="table-responsive mb-3">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">Sel.</th>
                                    <th>Posição</th>
                                    <th>Empreiteiro</th>
                                    <th>Pontuação</th>
                                    <th>Valor Total</th>
                                    <th>Prazo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.PropostasDisponiveis)
                                {
                                    var isChecked = p.Id == Model.PropostaVencedoraId;
                                    <tr class="@(p.IsPrimeiroLugar ? "table-success bg-opacity-10" : "")">
                                        <td>
                                            <input type="radio" name="PropostaVencedoraId" value="@p.Id" id="prop_@p.Id"
                                                   class="form-check-input radio-proposta"
                                                   @(isChecked ? "checked" : "") required />
                                        </td>
                                        <td>
                                            <span class="badge @(p.IsPrimeiroLugar ? "bg-success" : "bg-secondary")">@(p.PosicaoRanking)º Lugar</span>
                                            @if (p.IsPrimeiroLugar)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">Recomendado</span>
                                            }
                                        </td>
                                        <td><label for="prop_@p.Id" class="fw-bold mb-0 cursor-pointer">@p.Empreiteiro</label></td>
                                        <td><strong>@p.PontuacaoPonderada.ToString("0.00")</strong> / 5.00</td>
                                        <td>@p.ValorTotal.ToString("C")</td>
                                        <td>@(p.PrazoEntregaDias.HasValue ? $"{p.PrazoEntregaDias} dias" : "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <span asp-validation-for="PropostaVencedoraId" class="text-danger"></span>

                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label asp-for="ResponsavelAdjudicacao" class="form-label"></label>
                            <input asp-for="ResponsavelAdjudicacao" class="form-control" required />
                            <span asp-validation-for="ResponsavelAdjudicacao" class="text-danger"></span>
                        </div>

                        <div class="col-12" id="box-justificativa" style="display: none;">
                            <div class="alert alert-warning mb-2">
                                <i class="fas fa-exclamation-triangle me-1"></i>
                                <strong>Atenção:</strong> O empreiteiro selecionado diverge do 1º classificado no ranking. É obrigatório fundamentar a decisão.
                            </div>
                            <label asp-for="JustificativaAdjudicacao" class="form-label fw-bold"></label>
                            <textarea asp-for="JustificativaAdjudicacao" class="form-control" rows="3" id="input-justificativa"></textarea>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <span class="fas fa-check-circle me-1"></span> Confirmar Adjudicação
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.ProjetoObraId" class="btn btn-subtle-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><h5 class="mb-0">Regras de Adjudicação</h5></div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><i class="fas fa-info-circle text-primary me-2"></i>O ranking é calculado ponderando as notas atribuídas nos critérios definidos.</li>
                    <li class="mb-2"><i class="fas fa-award text-success me-2"></i>A proposta adjudicada passa a <strong>Aceite</strong> e as restantes ficam <strong>Rejeitadas</strong>.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var primeiroLugarId = $('#primeiro-lugar-id').val();

            function verificarJustificativa() {
                var selecionadoId = $('input[name="PropostaVencedoraId"]:checked').val();
                if (selecionadoId && primeiroLugarId && selecionadoId !== primeiroLugarId) {
                    $('#box-justificativa').slideDown();
                    $('#input-justificativa').attr('required', true);
                } else {
                    $('#box-justificativa').slideUp();
                    $('#input-justificativa').removeAttr('required');
                }
            }

            $('.radio-proposta').on('change', verificarJustificativa);
            verificarJustificativa();
        });
    </script>
}
