@using ComparacaoPropostas.Helper
@model List<ComparacaoPropostas.Models.Entities.ProjetoObra>
@{
    ViewData["Title"] = "Projetos de Obra";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Projetos de Obra</h2>
    <a class="btn btn-primary" asp-action="Create"><span class="fas fa-plus me-1"></span> Novo Projeto</a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">Ainda não existem projetos de obra registados.</div>
        }
        else
        {
            <table class="table table-hover data-table">
                <thead>
                    <tr>
                        <th>Designação</th>
                        <th>Tipo</th>
                        <th>Local</th>
                        <th>Cliente</th>
                        <th>Estado</th>
                        <th>Itens MQT</th>
                        <th>Propostas</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@p.Id">@p.Designacao</a></td>
                            <td>@p.Tipo.ToLabel()</td>
                            <td>@(p.Local ?? "-")</td>
                            <td>@(p.Cliente ?? "-")</td>
                            <td><span class="@p.Status.ToBadgeClass()">@p.Status.ToLabel()</span></td>
                            <td>@p.ItensMQT.Count</td>
                            <td>@p.Propostas.Select(pr => pr.Empreiteiro).Distinct().Count()</td>
                            <td class="text-end">
                                <div class="d-inline-flex flex-column gap-1">
                                    <a class="btn btn-sm btn-subtle-secondary" asp-action="Edit" asp-route-id="@p.Id">
                                        <i class="fas fa-edit me-1"></i> Editar
                                    </a>
                                    <button type="button" class="btn btn-sm btn-subtle-danger js-delete-btn"
                                            data-url="@Url.Action("Delete", new { id = p.Id })" data-id="@p.Id">
                                        <i class="fas fa-trash me-1"></i> Apagar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
