@model List<ComparacaoPropostas.Models.Entities.Avaliador>
@{
    ViewData["Title"] = "Avaliadores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Avaliadores</h2>
        <p class="text-body-tertiary mb-0">Gestão dos intervenientes/perfis autorizados para avaliação de propostas.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <span class="fas fa-user-plus me-1"></span> Novo Avaliador
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">
                Ainda não existem avaliadores registados. Adiciona o primeiro avaliador para começar a avaliar as propostas.
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Perfil / Cargo</th>
                        <th>E-mail</th>
                        <th>Estado</th>
                        <th>Data de Registo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td><strong>@a.Nome</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(a.Perfil) ? "-" : a.Perfil)</td>
                            <td>@(string.IsNullOrWhiteSpace(a.Email) ? "-" : a.Email)</td>
                            <td>
                                @if (a.Ativo)
                                {
                                    <span class="badge bg-success">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inativo</span>
                                }
                            </td>
                            <td>@a.CriadoEm.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-subtle-secondary" asp-action="Edit" asp-route-id="@a.Id">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
