@model ComparacaoPropostas.Models.Entities.Plano
@{
    ViewData["Title"] = "Editar Plano";
}

<h2>Editar Plano</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><span class="fas fa-save me-1"></span> Guardar</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-subtle-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
