@model ComparacaoPropostas.Models.Entities.Plano
@{
    ViewData["Title"] = "Novo Plano";
}

<h2>Novo Plano</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <partial name="_Form" model="Model" />
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><span class="fas fa-save me-1"></span> Criar Plano</button>
                <a asp-action="Index" class="btn btn-subtle-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
