@using ComparacaoPropostas.Helper
@using ComparacaoPropostas.Models.Entities.Enums
@model List<ComparacaoPropostas.Models.Entities.Plano>
@{
    ViewData["Title"] = "Planos Capex";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Planos Capex</h2>
    <a class="btn btn-primary" asp-action="Create"><span class="fas fa-plus me-1"></span> Novo Plano</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Importar" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-end">
            <div>
                <label class="form-label mb-1">Área</label>
                <select name="area" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<AreaDepartamento>()"></select>
            </div>
            <div>
                <label class="form-label mb-1">Importar plano a partir do ficheiro SCOPE de uma área (.xlsx)</label>
                <input type="file" name="ficheiro" accept=".xlsx" class="form-control form-control-sm" required />
            </div>
            <button type="submit" class="btn btn-subtle-success btn-sm">
                <span class="fas fa-upload me-1"></span> Importar como novo plano
            </button>
        </form>
        <div class="form-text">Lê as folhas "Scope DEP-INF", "Formação e feiras" e a capacidade da equipa em "Parâmetros plano".</div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">Ainda não existem planos registados.</div>
        }
        else
        {
            <table class="table table-hover data-table">
                <thead>
                    <tr>
                        <th>Ano</th>
                        <th>Designação</th>
                        <th>Departamento</th>
                        <th class="text-end">Projetos (aceites / propostos)</th>
                        <th class="text-end">Capex aprovado</th>
                        <th class="text-end">Formação e feiras</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var ativos = p.Projetos.Where(x => x.EstadoAprovacao == EstadoAprovacaoProjeto.Aceite && x.Caixa != CaixaPlano.ForaDoPlano).ToList();
                        <tr>
                            <td>@p.Ano</td>
                            <td><a asp-action="Details" asp-route-id="@p.Id">@p.Designacao</a></td>
                            <td>@(p.Departamento ?? "-")</td>
                            <td class="text-end">@ativos.Count / @p.Projetos.Count</td>
                            <td class="text-end">@ativos.Sum(x => x.TotalOrcamento).ToCve()</td>
                            <td class="text-end">@p.AcoesFormacao.Count</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-subtle-secondary btn-menu-acoes" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Opções"><i class="fas fa-ellipsis"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@p.Id"><i class="fas fa-pen me-2"></i>Editar</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><button type="button" class="dropdown-item text-danger js-delete-btn" data-url="@Url.Action("Delete", new { id = p.Id })" data-id="@p.Id"><i class="fas fa-trash me-2"></i>Apagar</button></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
