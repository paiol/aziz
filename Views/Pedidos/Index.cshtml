@model List<ComparacaoPropostas.Models.Entities.PedidoProposta>
@{
    ViewData["Title"] = "Pedidos de Proposta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Pedidos de Proposta</h2>
    <a class="btn btn-primary" asp-action="Create"><span class="fas fa-plus me-1"></span> Novo Pedido</a>
</div>
<p class="text-body-tertiary">
    Um Pedido de Proposta é o ponto de partida — regista aqui o tipo e a área, e depois cria um
    <a asp-controller="Processos" asp-action="Create">Novo Processo</a> escolhendo este pedido.
</p>

<div class="card mb-3">
    <div class="card-body">
        <label class="form-label mb-1">Filtrar por área</label>
        <select id="filtro-area" class="form-select" style="max-width:360px">
            <option value="">Todas as áreas</option>
            @foreach (var a in Model.Select(p => p.Area).Distinct().OrderBy(a => a))
            {
                <option value="@a">@a</option>
            }
        </select>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-hover data-table" id="tabela-pedidos">
            <thead>
                <tr>
                    <th>Tipo de Proposta</th>
                    <th>Área</th>
                    <th>Estado</th>
                    <th>Pessoa Criou</th>
                    <th>Criado em</th>
                    <th>Processo</th>
                    <th>Excel</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.TipoProposta</td>
                        <td>@p.Area</td>
                        <td>
                            @if (p.Status == ComparacaoPropostas.Models.Entities.Enums.StatusPedido.Respondido)
                            {
                                <span class="badge bg-success">Respondido</span>
                            }
                            else if (p.Status == ComparacaoPropostas.Models.Entities.Enums.StatusPedido.Cancelado)
                            {
                                <span class="badge bg-secondary">Cancelado</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pendente</span>
                            }
                        </td>
                        <td>@p.PessoaCriou</td>
                        <td>@p.CriadoEm.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (p.Processo != null)
                            {
                                <a asp-controller="Processos" asp-action="Details" asp-route-id="@p.Processo.Id">@p.Processo.Nome</a>
                            }
                            else
                            {
                                <span class="text-body-tertiary">-</span>
                            }
                        </td>
                        <td>
                            @if (p.ItensPedido.Count > 0)
                            {
                                <a class="btn btn-sm btn-subtle-primary" asp-action="ExportarExcel" asp-route-id="@p.Id">
                                    <span class="fas fa-download me-1"></span> Descarregar (@p.ItensPedido.Count)
                                </a>
                            }
                            else
                            {
                                <span class="text-body-tertiary">Sem itens</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-subtle-secondary" asp-controller="ItensPedido" asp-action="Index" asp-route-pedidoId="@p.Id">Gerir Itens</a>
                            @if (p.Processo == null)
                            {
                                <button type="button" class="btn btn-sm btn-subtle-danger js-delete-btn"
                                        data-url="@Url.Action("Delete", new { id = p.Id })" data-id="@p.Id">Apagar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var tabela = $('#tabela-pedidos').DataTable();
            $('#filtro-area').on('change', function () {
                var valor = this.value ? '^' + $.fn.dataTable.util.escapeRegex(this.value) + '$' : '';
                tabela.column(1).search(valor, true, false).draw();
            });
        });
    </script>
}
