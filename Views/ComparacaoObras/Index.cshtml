@using ComparacaoPropostas.Helper
@model ComparacaoPropostas.ViewModels.ComparacaoObra.ComparacaoObraViewModel
@{
    ViewData["Title"] = "Comparação de Propostas";
    var projeto = Model.ProjetoObra;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Mapa Comparativo de Propostas</h2>
        <p class="text-body-tertiary mb-0">Projeto: <strong>@projeto.Designacao</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-subtle-secondary" asp-controller="ProjetosObra" asp-action="Details" asp-route-id="@projeto.Id">
            <span class="fas fa-arrow-left me-1"></span> Voltar ao Projeto
        </a>
        @if (Model.Propostas.Count > 0)
        {
            <a class="btn btn-primary" asp-controller="ProjetosObra" asp-action="Adjudicar" asp-route-id="@projeto.Id">
                <span class="fas fa-trophy me-1"></span> Adjudicar
            </a>
        }
    </div>
</div>

@if (Model.Propostas.Count == 0)
{
    <div class="alert alert-info">Ainda não existem propostas para comparar neste projeto.</div>
}
else
{
    <div class="card mb-3 shadow-sm">
        <div class="card-header bg-light"><h5 class="mb-0">Ranking Geral</h5></div>
        <div class="card-body p-0 comparacao-table-wrapper" style="overflow-x: auto;">
            <table class="table table-bordered comparacao-table mb-0 align-middle">
                <thead>
                    <tr class="table-light">
                        <th class="linha-label" style="min-width: 200px; position: sticky; left: 0; background-color: #f8f9fa;">Empreiteiro</th>
                        @foreach (var col in Model.Propostas)
                        {
                            var isVencedor = projeto.PropostaVencedoraId == col.PropostaId;
                            <th class="text-center @(isVencedor ? "bg-success bg-opacity-10 text-success fw-bold" : "")" style="min-width: 180px;">
                                @col.Empreiteiro
                                @if (isVencedor)
                                {
                                    <span class="badge bg-success d-block mt-1"><i class="fas fa-check"></i> Adjudicado</span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="linha-label" style="position: sticky; left: 0; background-color: #fff;">Posição no Ranking</td>
                        @foreach (var col in Model.Propostas)
                        {
                            <td class="text-center">
                                <span class="badge @(col.PosicaoRanking == 1 ? "bg-success" : "bg-secondary")">@(col.PosicaoRanking)º Lugar</span>
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="linha-label" style="position: sticky; left: 0; background-color: #fff;">Estado</td>
                        @foreach (var col in Model.Propostas)
                        {
                            <td class="text-center"><span class="@col.Status.ToBadgeClass()">@col.Status.ToLabel()</span></td>
                        }
                    </tr>
                    <tr class="table-primary bg-opacity-10">
                        <td class="linha-label fw-bold" style="position: sticky; left: 0; background-color: #f0f7ff;">Pontuação Global (0 a 5)</td>
                        @foreach (var col in Model.Propostas)
                        {
                            <td class="text-center @(col.PontuacaoMelhor ? "cell-melhor fw-bold" : "")">
                                <span class="fs-1 fw-bold text-primary">@col.PontuacaoPonderada.ToString("0.00")</span>
                            </td>
                        }
                    </tr>
                    <tr class="table-info bg-opacity-10">
                        <td class="linha-label fw-bold" style="position: sticky; left: 0; background-color: #f0faff;">Valor Total</td>
                        @foreach (var col in Model.Propostas)
                        {
                            <td class="text-center @(col.ValorTotalMelhor ? "cell-melhor fw-bold" : "")">
                                @col.ValorTotal.ToString("C")
                                @if (col.ValorTotalMelhor)
                                {
                                    <span class="badge bg-success ms-1 small">Menor Preço</span>
                                }
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="linha-label" style="position: sticky; left: 0; background-color: #fff;">Prazo de Entrega</td>
                        @foreach (var col in Model.Propostas)
                        {
                            if (col.PrazoEntregaDias.HasValue)
                            {
                                <td class="text-center @(col.PrazoMelhor ? "cell-melhor" : "")">
                                    <strong>@col.PrazoEntregaDias dias</strong>
                                    @if (col.PrazoMelhor)
                                    {
                                        <span class="badge bg-success ms-1 small">Mais Rápido</span>
                                    }
                                </td>
                            }
                            else
                            {
                                <td class="text-center cell-indisponivel">-</td>
                            }
                        }
                    </tr>

                    @if (Model.LinhasCriterios.Count > 0)
                    {
                        <tr class="table-secondary">
                            <td colspan="@(Model.Propostas.Count + 1)" class="fw-bold py-2 text-uppercase fs--1">
                                <i class="fas fa-list-check me-1"></i> Desagregação por Critério (Notas: 1 a 5)
                            </td>
                        </tr>
                        @foreach (var linha in Model.LinhasCriterios)
                        {
                            <tr>
                                <td class="linha-label" style="position: sticky; left: 0; background-color: #fff;">
                                    <strong>@linha.CriterioNome</strong>
                                    <span class="badge bg-subtle-primary text-primary ms-1">@linha.Peso.ToString("0.##")%</span>
                                </td>
                                @foreach (var col in Model.Propostas)
                                {
                                    var nota = linha.NotasPorProposta.GetValueOrDefault(col.PropostaId);
                                    var melhor = linha.MelhorPorProposta.GetValueOrDefault(col.PropostaId);
                                    if (nota.HasValue)
                                    {
                                        <td class="text-center @(melhor ? "cell-melhor" : "")">
                                            <span class="fw-bold">@nota.Value.ToString("0.##")</span> <small class="text-muted">/ 5</small>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="text-center cell-indisponivel text-muted small">Sem avaliação</td>
                                    }
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.LinhasItens.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light"><h5 class="mb-0">Comparação Item a Item (MQT)</h5></div>
            <div class="card-body p-0 comparacao-table-wrapper" style="overflow-x: auto;">
                <table class="table table-bordered table-hover comparacao-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="linha-label" rowspan="2" style="min-width: 240px; position: sticky; left: 0; background-color: #f8f9fa; z-index: 2;">Item / Descrição</th>
                            <th rowspan="2" class="text-center" style="min-width: 100px;">Qtd. MQT</th>
                            @foreach (var col in Model.Propostas)
                            {
                                <th colspan="3" class="text-center" style="min-width: 220px;">@col.Empreiteiro</th>
                            }
                        </tr>
                        <tr class="table-light">
                            @foreach (var col in Model.Propostas)
                            {
                                <th class="text-center small" style="min-width: 70px;">Qtd.</th>
                                <th class="text-center small" style="min-width: 90px;">P. Unit.</th>
                                <th class="text-center small" style="min-width: 100px;">Subtotal</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var linha in Model.LinhasItens)
                        {
                            <tr class="@(linha.NaoPrevisto ? "table-warning" : "")">
                                <td class="linha-label fw-bold" style="position: sticky; left: 0; background-color: #fff; z-index: 1;">
                                    @linha.Descricao @(string.IsNullOrWhiteSpace(linha.Unidade) ? "" : $"({linha.Unidade})")
                                    @if (linha.NaoPrevisto)
                                    {
                                        <span class="badge bg-warning text-dark ms-1 small">Não previsto</span>
                                    }
                                </td>
                                <td class="text-center">@linha.QuantidadeSolicitada.ToString("0.###")</td>
                                @foreach (var col in Model.Propostas)
                                {
                                    var incluido = linha.IncluidoPorProposta.GetValueOrDefault(col.PropostaId);
                                    var quantidade = linha.QuantidadePorProposta.GetValueOrDefault(col.PropostaId);
                                    var preco = linha.PrecoPorProposta.GetValueOrDefault(col.PropostaId);
                                    var subtotal = linha.SubtotalPorProposta.GetValueOrDefault(col.PropostaId);
                                    var melhor = linha.MelhorPorProposta.GetValueOrDefault(col.PropostaId);
                                    if (incluido && preco.HasValue)
                                    {
                                        <td class="text-center">@quantidade?.ToString("0.###")</td>
                                        <td class="text-center">@preco.Value.ToString("C")</td>
                                        <td class="text-center @(melhor ? "cell-melhor fw-bold" : "")">@((subtotal ?? 0).ToString("C"))</td>
                                    }
                                    else
                                    {
                                        <td colspan="3" class="text-center cell-indisponivel text-muted small">Não incluído</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
