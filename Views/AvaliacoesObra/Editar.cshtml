@model ComparacaoPropostas.ViewModels.AvaliacoesObra.AvaliacaoObraFormVM
@{
    ViewData["Title"] = "Avaliar Proposta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Avaliação da Proposta</h2>
        <p class="text-body-tertiary mb-0">Empreiteiro: <strong>@Model.Empreiteiro</strong></p>
    </div>
    <a asp-controller="ProjetosObra" asp-action="Details" asp-route-id="@Model.ProjetoObraId" class="btn btn-subtle-secondary">
        <span class="fas fa-arrow-left me-1"></span> Voltar ao Projeto
    </a>
</div>

@if (Model.Itens.Count == 0)
{
    <div class="alert alert-warning">
        Este projeto ainda não tem critérios de avaliação definidos.
        <a asp-controller="CriteriosObra" asp-action="Index" asp-route-projetoObraId="@Model.ProjetoObraId">Definir critérios</a> primeiro.
    </div>
}
else
{
    <form asp-action="Editar" method="post" id="form-avaliacao">
        <input type="hidden" asp-for="PropostaEmpreiteiroId" />
        <input type="hidden" asp-for="Empreiteiro" />
        <input type="hidden" asp-for="ProjetoObraId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light"><h5 class="mb-0"><i class="fas fa-user-check me-2"></i> Avaliador</h5></div>
            <div class="card-body">
                <label asp-for="Avaliador" class="form-label">Nome / Email do Avaliador (opcional)</label>
                <input asp-for="Avaliador" class="form-control" placeholder="ex.: João Silva" />
            </div>
        </div>

        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-star text-warning me-2"></i> Pontuação dos Critérios (1 a 5 Estrelas)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Critério</th>
                                <th style="width: 100px;">Peso</th>
                                <th style="width: 220px;">Classificação</th>
                                <th>Comentário</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Itens.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" asp-for="Itens[i].CriterioObraId" />
                                        <input type="hidden" asp-for="Itens[i].CriterioNome" />
                                        <input type="hidden" asp-for="Itens[i].Peso" />
                                        <strong class="text-dark">@Model.Itens[i].CriterioNome</strong>
                                    </td>
                                    <td><span class="badge bg-subtle-primary text-primary">@Model.Itens[i].Peso.ToString("0.##")%</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="hidden" asp-for="Itens[i].Nota" id="nota_input_@i" class="nota-hidden-input" />
                                            <div class="star-rating-widget" data-index="@i">
                                                @for (var star = 1; star <= 5; star++)
                                                {
                                                    <i class="fa-star star-icon cursor-pointer @(star <= Model.Itens[i].Nota ? "fas text-warning" : "far text-secondary")"
                                                       data-val="@star" title="@star estrela(s)"></i>
                                                }
                                            </div>
                                            <span class="fw-bold ms-1 text-primary nota-label" id="nota_lbl_@i">@Model.Itens[i].Nota / 5</span>
                                        </div>
                                    </td>
                                    <td><input type="text" class="form-control form-control-sm" asp-for="Itens[i].Comentario" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><span class="fas fa-save me-1"></span> Guardar Avaliação</button>
            <a asp-controller="ProjetosObra" asp-action="Details" asp-route-id="@Model.ProjetoObraId" class="btn btn-subtle-secondary">Cancelar</a>
        </div>
    </form>
}

@section Scripts {
    <script>
        $(function () {
            $('.star-rating-widget').each(function () {
                var widget = $(this);
                var index = widget.data('index');
                var hiddenInput = $('#nota_input_' + index);
                var label = $('#nota_lbl_' + index);

                widget.find('.star-icon').on('click', function () {
                    var val = parseInt($(this).data('val'), 10);
                    hiddenInput.val(val);
                    label.text(val + ' / 5');

                    widget.find('.star-icon').each(function () {
                        var starVal = parseInt($(this).data('val'), 10);
                        if (starVal <= val) {
                            $(this).removeClass('far text-secondary').addClass('fas text-warning');
                        } else {
                            $(this).removeClass('fas text-warning').addClass('far text-secondary');
                        }
                    });
                });
            });
        });
    </script>
}
