@using ComparacaoPropostas.Helper
@using ComparacaoPropostas.Models.Entities.Enums
@model List<ComparacaoPropostas.Models.Entities.ProjetoPlano>
@{
    var plano = (ComparacaoPropostas.Models.Entities.Plano)ViewBag.Plano;
    var caixa = (CaixaPlano?)ViewBag.Caixa;
    var area = (AreaDepartamento?)ViewBag.Area;
    var aprovacao = (EstadoAprovacaoProjeto?)ViewBag.Aprovacao;
    var voltar = Context.Request.Path + Context.Request.QueryString;
    var propostosQueEntram = Model.Count(p => p.EstadoAprovacao == EstadoAprovacaoProjeto.Proposto && p.Caixa == CaixaPlano.Entra);
    ViewData["Title"] = "Projetos do Plano";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Projetos propostos — @plano.Designacao</h2>
        <a asp-controller="Planos" asp-action="Details" asp-route-id="@plano.Id" class="small"><span class="fas fa-arrow-left me-1"></span>Voltar ao resumo do plano</a>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (propostosQueEntram > 0)
        {
            <form asp-action="AceitarQueEntram" method="post" onsubmit="return confirm('Aceitar os @propostosQueEntram projeto(s) propostos que entram no plano@(area == null ? "" : $" da área {area.Value.ToLabel()}")?');">
                <input type="hidden" name="planoId" value="@plano.Id" />
                <input type="hidden" name="area" value="@area" />
                <button type="submit" class="btn btn-subtle-success"><span class="fas fa-check-double me-1"></span> Aceitar os que entram (@propostosQueEntram)</button>
            </form>
        }
        <a class="btn btn-primary" asp-action="Create" asp-route-planoId="@plano.Id" asp-route-area="@area"><span class="fas fa-plus me-1"></span> Propor Projeto</a>
    </div>
</div>

<form method="get" class="card mb-3">
    <div class="card-body row g-2 align-items-end">
        <input type="hidden" name="planoId" value="@plano.Id" />
        <div class="col-md-3">
            <label class="form-label mb-1">Área</label>
            <select name="area" class="form-select form-select-sm" asp-items="Enum.GetValues<AreaDepartamento>().Select(a => new SelectListItem(a.ToLabel(), a.ToString(), a == area))" onchange="this.form.submit()">
                <option value="" selected="@(area == null)">Todas as áreas</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label mb-1">Aprovação</label>
            <select name="aprovacao" class="form-select form-select-sm" asp-items="Enum.GetValues<EstadoAprovacaoProjeto>().Select(a => new SelectListItem(a.ToLabel(), a.ToString(), a == aprovacao))" onchange="this.form.submit()">
                <option value="" selected="@(aprovacao == null)">Todos</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label mb-1">Caixa do plano</label>
            <select name="caixa" class="form-select form-select-sm" asp-items="Enum.GetValues<CaixaPlano>().Select(a => new SelectListItem(a.ToLabel(), a.ToString(), a == caixa))" onchange="this.form.submit()">
                <option value="" selected="@(caixa == null)">Todas</option>
            </select>
        </div>
        <div class="col-md-3 text-md-end">
            <a class="btn btn-sm btn-subtle-secondary" asp-action="Index" asp-route-planoId="@plano.Id">Limpar filtros</a>
        </div>
    </div>
</form>

<form id="form-varios" asp-action="DecidirVarios" method="post" class="card mb-2 d-none" aria-label="Decidir os projetos selecionados">
    <input type="hidden" name="planoId" value="@plano.Id" />
    <input type="hidden" name="voltarPara" value="@voltar" />
    <input type="hidden" name="motivo" />
    <div class="card-body py-2 d-flex align-items-center gap-2 flex-wrap">
        <span class="fw-semibold"><span id="sel-num">0</span> projeto(s) selecionado(s)</span>
        <button type="submit" name="estado" value="@EstadoAprovacaoProjeto.Aceite" class="btn btn-sm btn-success"><i class="fas fa-check me-1"></i>Aceitar</button>
        <button type="submit" name="estado" value="@EstadoAprovacaoProjeto.Rejeitado" class="btn btn-sm btn-subtle-danger" data-pede-motivo="1"><i class="fas fa-xmark me-1"></i>Rejeitar</button>
        <button type="submit" name="estado" value="@EstadoAprovacaoProjeto.Proposto" class="btn btn-sm btn-subtle-secondary"><i class="fas fa-rotate-left me-1"></i>Voltar a proposto</button>
        <button type="button" id="sel-limpar" class="btn btn-sm btn-link">Limpar seleção</button>
    </div>
</form>

<div class="card">
    <div class="card-body table-responsive">
        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">Não existem projetos com estes filtros.</div>
        }
        else
        {
            <table class="table table-hover table-sm data-table">
                <thead>
                    <tr>
                        <th style="width: 1%" data-orderable="false"><input type="checkbox" class="form-check-input" id="sel-todos" title="Selecionar todos (os filtrados)" aria-label="Selecionar todos" /></th>
                        <th>Área</th>
                        <th>Projeto</th>
                        <th>Rubrica</th>
                        <th>Situação</th>
                        <th>Caixa</th>
                        <th>Aprovação</th>
                        <th class="text-end">Transitado</th>
                        <th class="text-end">Novo</th>
                        <th class="text-end">TOTAL ORC.</th>
                        <th class="text-end">Δ vs @(plano.Ano - 1)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="@(p.EstadoAprovacao == EstadoAprovacaoProjeto.Rejeitado ? "text-body-tertiary" : "")">
                            <td><input type="checkbox" class="form-check-input js-sel" value="@p.Id" aria-label="Selecionar @p.Nome" /></td>
                            <td>@p.Area.ToLabel()</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@p.Id">@p.Nome</a>
                                @if (!string.IsNullOrWhiteSpace(p.Descricao))
                                {
                                    <div class="small text-body-tertiary text-truncate" style="max-width: 22rem" title="@p.Descricao">@p.Descricao</div>
                                }
                            </td>
                            <td class="small">@(p.DesignacaoRubrica ?? "-")</td>
                            <td>@(p.Situacao?.ToLabel() ?? "-")</td>
                            <td><span class="@p.Caixa.ToBadgeClass()">@p.Caixa.ToLabel()</span></td>
                            <td>
                                <span class="@p.EstadoAprovacao.ToBadgeClass()">@p.EstadoAprovacao.ToLabel()</span>
                                @if (!string.IsNullOrWhiteSpace(p.MotivoDecisao))
                                {
                                    <div class="small text-body-tertiary">@p.MotivoDecisao</div>
                                }
                            </td>
                            <td class="text-end" data-order="@p.ValorTransitar">@p.ValorTransitar.ToCve()</td>
                            <td class="text-end" data-order="@p.ValorNovo">@p.ValorNovo.ToCve()</td>
                            <td class="text-end fw-semibold" data-order="@p.TotalOrcamento">@p.TotalOrcamento.ToCve()</td>
                            <td class="text-end @(p.DeltaAnoAnterior < 0 ? "text-danger" : "")" data-order="@p.DeltaAnoAnterior">@p.DeltaAnoAnterior.ToCve()</td>
                            <td class="text-end">
                                <form id="decidir-@p.Id" asp-action="Decidir" asp-route-id="@p.Id" method="post" class="d-none">
                                    <input type="hidden" name="voltarPara" value="@voltar" />
                                    <input type="hidden" name="motivo" />
                                </form>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-subtle-secondary btn-menu-acoes" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Opções"><i class="fas fa-ellipsis"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        @if (p.EstadoAprovacao != EstadoAprovacaoProjeto.Aceite)
                                        {
                                            <li><button type="submit" form="decidir-@p.Id" name="estado" value="@EstadoAprovacaoProjeto.Aceite" class="dropdown-item text-success"><i class="fas fa-check me-2"></i>Aceitar</button></li>
                                        }
                                        @if (p.EstadoAprovacao != EstadoAprovacaoProjeto.Rejeitado)
                                        {
                                            <li><button type="submit" form="decidir-@p.Id" name="estado" value="@EstadoAprovacaoProjeto.Rejeitado" class="dropdown-item text-warning"
                                                        onclick="var m = prompt('Motivo da rejeição (opcional):'); if (m === null) return false; document.querySelector('#decidir-@p.Id [name=motivo]').value = m;"><i class="fas fa-xmark me-2"></i>Rejeitar</button></li>
                                        }
                                        @if (p.EstadoAprovacao != EstadoAprovacaoProjeto.Proposto)
                                        {
                                            <li><button type="submit" form="decidir-@p.Id" name="estado" value="@EstadoAprovacaoProjeto.Proposto" class="dropdown-item"><i class="fas fa-rotate-left me-2"></i>Voltar a proposto</button></li>
                                        }
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@p.Id"><i class="fas fa-eye me-2"></i>Ver detalhes</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@p.Id"><i class="fas fa-pen me-2"></i>Editar</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><button type="button" class="dropdown-item text-danger js-delete-btn" data-url="@Url.Action("Delete", new { id = p.Id })" data-id="@p.Id"><i class="fas fa-trash me-2"></i>Apagar</button></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="7">Total (@Model.Count projeto(s); rejeitados não contam)</td>
                        @{ var contam = Model.Where(p => p.EstadoAprovacao != EstadoAprovacaoProjeto.Rejeitado).ToList(); }
                        <td class="text-end">@contam.Sum(p => p.ValorTransitar ?? 0).ToCve()</td>
                        <td class="text-end">@contam.Sum(p => p.ValorNovo ?? 0).ToCve()</td>
                        <td class="text-end">@contam.Sum(p => p.TotalOrcamento).ToCve()</td>
                        <td class="text-end">@contam.Sum(p => p.DeltaAnoAnterior).ToCve()</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Seleção de vários projetos: funciona em todas as páginas da tabela (DataTables só mostra uma de cada vez).
        $(function () {
            var $tabela = $('.data-table');
            if (!$tabela.length) return;
            var dt = $tabela.DataTable();
            var $barra = $('#form-varios');

            function selecionados() { return dt.$('input.js-sel:checked'); }
            function atualizar() {
                var n = selecionados().length;
                $('#sel-num').text(n);
                $barra.toggleClass('d-none', n === 0);
                var visiveis = $(dt.rows({ search: 'applied' }).nodes()).find('input.js-sel');
                $('#sel-todos').prop('checked', visiveis.length > 0 && visiveis.filter(':checked').length === visiveis.length);
            }

            $tabela.on('change', 'input.js-sel', atualizar);
            $('#sel-todos').on('click', function (e) {
                e.stopPropagation();   // não ordenar a coluna
                $(dt.rows({ search: 'applied' }).nodes()).find('input.js-sel').prop('checked', this.checked);
                atualizar();
            });
            $('#sel-limpar').on('click', function () { dt.$('input.js-sel').prop('checked', false); atualizar(); });

            var botao = null;
            $barra.on('click', 'button[type=submit]', function () { botao = this; });
            $barra.on('submit', function () {
                var n = selecionados().length;
                if (n === 0) return false;
                var texto = $(botao).text().trim();
                if (botao && $(botao).data('pede-motivo')) {
                    var m = prompt('Motivo da rejeição dos ' + n + ' projeto(s) (opcional):');
                    if (m === null) return false;
                    $barra.find('[name=motivo]').val(m);
                } else if (!confirm(texto + ' ' + n + ' projeto(s)?')) {
                    return false;
                }
                $barra.find('input.js-id').remove();
                selecionados().each(function () {
                    $('<input type="hidden" name="ids" class="js-id">').val(this.value).appendTo($barra);
                });
                return true;
            });
            atualizar();
        });
    </script>
}
