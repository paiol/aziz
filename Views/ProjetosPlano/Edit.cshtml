@using ComparacaoPropostas.Helper
@model ComparacaoPropostas.Models.Entities.ProjetoPlano
@{
    var plano = (ComparacaoPropostas.Models.Entities.Plano)ViewBag.Plano;
    ViewData["Title"] = "Editar Projeto do Plano";
}

<div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
    <h2 class="mb-0">Editar Projeto — @plano.Designacao</h2>
    <span class="@Model.Caixa.ToBadgeClass() fs-6">@Model.Caixa.ToLabel()</span>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PlanoId" />
    <partial name="_Form" model="Model" />
    <div class="mt-3 mb-4">
        <button type="submit" class="btn btn-primary"><span class="fas fa-save me-1"></span> Guardar</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-subtle-secondary">Cancelar</a>
    </div>
</form>
