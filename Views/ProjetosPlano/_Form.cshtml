            </div>
            <div class="col-md-2">
                <label asp-for="CustoServicos" class="form-label"></label>
                <input asp-for="CustoServicos" class="form-control" type="text" inputmode="decimal" />
            </div>
            <div class="col-md-2">
                <label asp-for="CustoDeslocacoes" class="form-label"></label>
                <input asp-for="CustoDeslocacoes" class="form-control" type="text" inputmode="decimal" />
