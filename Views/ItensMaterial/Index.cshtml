@model List<ComparacaoPropostas.Models.Entities.ItemMaterial>
@{
    ViewData["Title"] = "Itens / Materiais";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Itens / Materiais</h2>
    <a class="btn btn-primary" asp-action="Create"><span class="fas fa-plus me-1"></span> Novo Item</a>
</div>
<p class="text-body-tertiary">Um item pode ter vários sub-itens (mini itens) — úteis quando um material se desdobra em várias componentes cotáveis separadamente.</p>

<div class="card">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Categoria</th>
                    <th>Unidade</th>
                    <th>Domínio</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var isSubItem = item.ItemPaiId != null;
                    <tr>
                        <td>
                            @if (isSubItem)
                            {
                                <span class="text-body-tertiary ms-3">&#8627; @item.NomeItem</span>
                            }
                            else
                            {
                                <strong>@item.NomeItem</strong>
                            }
                        </td>
                        <td>@item.Categoria</td>
                        <td>@item.Unidade</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Dominio) ? "Qualquer" : item.Dominio)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-subtle-secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                            <button type="button" class="btn btn-sm btn-subtle-danger js-delete-btn"
                                    data-url="@Url.Action("Delete", new { id = item.Id })" data-id="@item.Id">Apagar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
