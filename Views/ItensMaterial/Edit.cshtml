@model ComparacaoPropostas.Models.Entities.ItemMaterial
@{
    ViewData["Title"] = "Editar Item";
    var itensPai = (List<ComparacaoPropostas.Models.Entities.ItemMaterial>)ViewBag.ItensPai;
}

<h2>Editar Item / Material</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NomeItem" class="form-label"></label>
                    <input asp-for="NomeItem" class="form-control" />
                    <span asp-validation-for="NomeItem" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Categoria" class="form-label"></label>
                    <input asp-for="Categoria" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Unidade" class="form-label"></label>
                    <input asp-for="Unidade" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ItemPaiId" class="form-label">Item Pai (opcional)</label>
                    <select asp-for="ItemPaiId" class="form-select">
                        <option value="">— Nenhum (item de topo) —</option>
                        @foreach (var pai in itensPai)
                        {
                            <option value="@pai.Id">@pai.NomeItem</option>
                        }
                    </select>
                    <span asp-validation-for="ItemPaiId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Descricao" class="form-label"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-subtle-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
