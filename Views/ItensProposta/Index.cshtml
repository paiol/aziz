@model ComparacaoPropostas.ViewModels.ItensProposta.ItensPropostaIndexVM
@{
    var proposta = Model.Proposta;
    ViewData["Title"] = "Itens da Proposta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Itens da Proposta — @proposta.Fornecedor</h2>
    <a class="btn btn-primary" asp-action="Create" asp-route-propostaId="@proposta.Id"><span class="fas fa-plus me-1"></span> Adicionar Itens</a>
</div>

@if (proposta.PedidoPropostaId.HasValue)
{
    <div class="alert alert-info">
        Esta proposta foi criada a partir de um <a asp-controller="Pedidos" asp-action="Index" asp-route-processoId="@proposta.ProcessoId" class="alert-link">Pedido de Proposta</a> enviado ao fornecedor.
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Incluído</th>
                    <th>Qtd. Solicitada</th>
                    <th>Qtd. Fornecida</th>
                    <th>Preço Unitário</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Itens)
                {
                    var difere = item.QuantidadeSolicitada.HasValue && item.QuantidadeSolicitada.Value != item.Quantidade;
                    <tr>
                        <td>@item.ItemMaterial.NomeItem</td>
                        <td>@(item.Incluido ? "Sim" : "Não")</td>
                        <td>@(item.QuantidadeSolicitada?.ToString() ?? "-")</td>
                        <td class="@(difere ? "cell-melhor" : "")">@item.Quantidade</td>
                        <td>@item.PrecoUnitario.ToString("C")</td>
                        <td>@item.Subtotal.ToString("C")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-subtle-secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                            <button type="button" class="btn btn-sm btn-subtle-danger js-delete-btn"
                                    data-url="@Url.Action("Delete", new { id = item.Id })" data-id="@item.Id">Apagar</button>
                        </td>
                    </tr>
                }
                @if (Model.Itens.Count == 0)
                {
                    <tr><td colspan="7" class="text-body-tertiary">Ainda não há itens nesta proposta.</td></tr>
                }
            </tbody>
            @if (Model.Itens.Count > 0)
            {
                <tfoot>
                    <tr class="fw-bold border-top border-2">
                        <td colspan="3">Total Geral</td>
                        <td>@Model.QuantidadeGeral</td>
                        <td></td>
                        <td>@Model.ValorGeral.ToString("C")</td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
        <p class="text-body-tertiary small mt-2 mb-0">Quantidade fornecida destacada quando difere da quantidade solicitada.</p>
    </div>
</div>

@if (Model.ResumoPorItem.Count > 1)
{
    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0">Resumo por Item</h5></div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantidade Total</th>
                        <th>Valor Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.ResumoPorItem)
                    {
                        <tr>
                            <td>@r.NomeItem</td>
                            <td>@r.QuantidadeTotal</td>
                            <td>@r.ValorTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<a class="btn btn-subtle-secondary" asp-controller="Processos" asp-action="Details" asp-route-id="@proposta.ProcessoId">Voltar ao Processo</a>
