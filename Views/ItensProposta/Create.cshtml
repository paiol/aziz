@model ComparacaoPropostas.ViewModels.ItensProposta.NovosItensPropostaVM
@{
    ViewData["Title"] = "Adicionar Itens à Proposta";
    var itens = (List<ComparacaoPropostas.Models.Entities.ItemMaterial>)ViewBag.Itens;
    var dominios = (List<string>)ViewBag.Dominios;
}

<h2>Adicionar Itens — @ViewBag.PropostaFornecedor</h2>
<p class="text-body-tertiary">Adiciona quantas linhas precisares com o botão "+". Todas as linhas são guardadas de uma vez.</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="card mb-3">
    <div class="card-body">
        <label class="form-label">Filtrar itens por domínio</label>
        <select id="filtro-dominio" class="form-select" style="max-width:360px">
            <option value="">Todos os domínios</option>
            @foreach (var d in dominios)
            {
                <option value="@d">@d</option>
            }
        </select>
        <div class="form-text">Escolhe um domínio para reduzir a lista de itens abaixo (ex: só "Acessórios energia" ou só "Acessórios torre").</div>
    </div>
</div>

<form asp-action="Create" method="post">
    <input type="hidden" name="PropostaId" value="@Model.PropostaId" />

    <div class="card">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th style="min-width:260px">Item</th>
                        <th style="width:130px">Qtd. Solicitada</th>
                        <th style="width:120px">Qtd. Fornecida</th>
                        <th style="width:160px">Preço Unitário</th>
                        <th style="width:90px">Incluído</th>
                        <th>Observação</th>
                        <th style="width:50px"></th>
                    </tr>
                </thead>
                <tbody id="itens-tbody"></tbody>
            </table>
        </div>
        <div class="card-footer">
            <button type="button" id="btn-add-row" class="btn btn-sm btn-subtle-primary">
                <span class="fas fa-plus me-1"></span> Adicionar Linha
            </button>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar Itens</button>
        <a asp-action="Index" asp-route-propostaId="@Model.PropostaId" class="btn btn-subtle-secondary">Cancelar</a>
    </div>
</form>

<template id="item-row-template">
    <tr>
        <td>
            <input type="hidden" name="Itens.Index" value="__INDEX__" class="js-row-index" />
            <select name="Itens[__INDEX__].ItemMaterialId" class="form-select form-select-sm js-item-select" required>
                <option value="">— Selecione —</option>
                @foreach (var i in itens)
                {
                    var prefixo = i.ItemPaiId != null ? "— " : "";
                    var sufixoUnidade = string.IsNullOrWhiteSpace(i.Unidade) ? "" : $" · {i.Unidade}";
                    <option value="@i.Id" data-dominio="@(i.Dominio ?? "")">@prefixo@i.NomeItem@sufixoUnidade</option>
                }
            </select>
        </td>
        <td><input type="number" step="0.001" name="Itens[__INDEX__].QuantidadeSolicitada" class="form-control form-control-sm" placeholder="opcional" /></td>
        <td><input type="number" step="0.001" value="1" name="Itens[__INDEX__].Quantidade" class="form-control form-control-sm" required /></td>
        <td><input type="number" step="0.01" value="0" name="Itens[__INDEX__].PrecoUnitario" class="form-control form-control-sm" required /></td>
        <td class="text-center">
            <input type="checkbox" name="Itens[__INDEX__].Incluido" value="true" class="form-check-input" checked />
            <input type="hidden" name="Itens[__INDEX__].Incluido" value="false" />
        </td>
        <td><input type="text" name="Itens[__INDEX__].Observacao" class="form-control form-control-sm" /></td>
        <td class="text-end">
            <button type="button" class="btn btn-sm btn-subtle-danger js-remove-row"><span class="fas fa-xmark"></span></button>
        </td>
    </tr>
</template>

@section Scripts {
    <script>
        (function () {
            var rowCount = 0;

            function aplicarFiltroEm(select) {
                var filtro = document.getElementById('filtro-dominio').value;
                var selecaoAtual = select.value;
                select.querySelectorAll('option[data-dominio]').forEach(function (opt) {
                    var visivel = !filtro || opt.getAttribute('data-dominio') === filtro || opt.getAttribute('data-dominio') === '';
                    opt.hidden = !visivel;
                    opt.disabled = !visivel;
                });
                var aindaVisivel = select.querySelector('option[value="' + selecaoAtual + '"]:not([hidden])');
                if (selecaoAtual && !aindaVisivel) select.value = '';
            }

            function aplicarFiltroEmTodas() {
                document.querySelectorAll('.js-item-select').forEach(aplicarFiltroEm);
            }

            function adicionarLinha() {
                var tpl = document.getElementById('item-row-template');
                var clone = tpl.content.cloneNode(true);
                var idx = 'r' + (rowCount++);

                clone.querySelector('.js-row-index').value = idx;
                clone.querySelectorAll('[name]').forEach(function (el) {
                    el.name = el.name.replace('__INDEX__', idx);
                });
                clone.querySelector('.js-remove-row').addEventListener('click', function (e) {
                    e.target.closest('tr').remove();
                });

                var select = clone.querySelector('.js-item-select');
                document.getElementById('itens-tbody').appendChild(clone);
                aplicarFiltroEm(select);
            }

            document.getElementById('btn-add-row').addEventListener('click', adicionarLinha);
            document.getElementById('filtro-dominio').addEventListener('change', aplicarFiltroEmTodas);
            adicionarLinha();
        })();
    </script>
}
