@model ComparacaoPropostas.ViewModels.ItensPedido.NovoItensPedidoVM
@{
    ViewData["Title"] = "Adicionar Itens a Pedir";
    var categorias = (List<string>)ViewBag.Categorias;
}

<h2>Adicionar Itens a Pedir — @ViewBag.PedidoTipo</h2>
<p class="text-body-tertiary">Escolhe a Categoria para carregar os Materiais da Base de Dados (Item Energia, MBB, FBB e Core) dessa categoria. Depois de gravar, podes descarregar o Excel para enviar ao fornecedor.</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Create" method="post">
    <input type="hidden" name="PedidoId" value="@Model.PedidoId" />

    <div class="card">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th style="min-width:200px">Categoria</th>
                        <th style="min-width:260px">Material</th>
                        <th style="width:140px">Quantidade Solicitada</th>
                        <th>Observação</th>
                        <th style="width:50px"></th>
                    </tr>
                </thead>
                <tbody id="itens-tbody"></tbody>
            </table>
        </div>
        <div class="card-footer">
            <button type="button" id="btn-add-row" class="btn btn-sm btn-subtle-primary">
                <span class="fas fa-plus me-1"></span> Adicionar Linha
            </button>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar Itens</button>
        <a asp-action="Index" asp-route-pedidoId="@Model.PedidoId" class="btn btn-subtle-secondary">Cancelar</a>
    </div>
</form>

<template id="item-row-template">
    <tr>
        <td>
            <input type="hidden" name="Itens.Index" value="__INDEX__" class="js-row-index" />
            <select class="form-select form-select-sm js-categoria">
                <option value="">— Categoria —</option>
                @foreach (var c in categorias)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </td>
        <td>
            <select name="Itens[__INDEX__].ChaveItem" class="form-select form-select-sm js-material" required disabled>
                <option value="">— Escolhe a categoria primeiro —</option>
            </select>
        </td>
        <td><input type="number" step="0.001" value="1" name="Itens[__INDEX__].QuantidadeSolicitada" class="form-control form-control-sm" required /></td>
        <td><input type="text" name="Itens[__INDEX__].Observacao" class="form-control form-control-sm" /></td>
        <td class="text-end">
            <button type="button" class="btn btn-sm btn-subtle-danger js-remove-row"><span class="fas fa-xmark"></span></button>
        </td>
    </tr>
</template>

@section Scripts {
    <script>
        (function () {
            var rowCount = 0;
            var obterMateriaisUrl = '@Url.Action("ObterMateriais")';

            var origemLabel = { 'Energia': 'Energia', 'MBB': 'MBB', 'FBB': 'FBB', 'Core': 'Core' };

            function carregarMateriais(categoriaSelect, materialSelect) {
                var categoria = categoriaSelect.value;
                materialSelect.innerHTML = '';
                materialSelect.disabled = true;

                if (!categoria) {
                    materialSelect.appendChild(new Option('— Escolhe a categoria primeiro —', ''));
                    return;
                }

                materialSelect.appendChild(new Option('A carregar...', ''));

                fetch(obterMateriaisUrl + '?categoria=' + encodeURIComponent(categoria))
                    .then(function (resp) { return resp.json(); })
                    .then(function (lista) {
                        materialSelect.innerHTML = '';
                        if (lista.length === 0) {
                            materialSelect.appendChild(new Option('Sem materiais nesta categoria', ''));
                            return;
                        }
                        materialSelect.appendChild(new Option('— Selecione —', ''));
                        lista.forEach(function (r) {
                            var origem = origemLabel[r.origem] || r.origem;
                            var texto = r.nome + (r.unidade ? ' · ' + r.unidade : '') + ' (' + origem + ')';
                            materialSelect.appendChild(new Option(texto, r.chave));
                        });
                        materialSelect.disabled = false;
                    })
                    .catch(function () {
                        materialSelect.innerHTML = '';
                        materialSelect.appendChild(new Option('Erro ao carregar materiais', ''));
                    });
            }

            function ligarLinha(tr) {
                var categoriaSelect = tr.querySelector('.js-categoria');
                var materialSelect = tr.querySelector('.js-material');

                categoriaSelect.addEventListener('change', function () {
                    carregarMateriais(categoriaSelect, materialSelect);
                });
            }

            function adicionarLinha() {
                var tpl = document.getElementById('item-row-template');
                var clone = tpl.content.cloneNode(true);
                var idx = 'r' + (rowCount++);

                clone.querySelector('.js-row-index').value = idx;
                clone.querySelectorAll('[name]').forEach(function (el) {
                    el.name = el.name.replace('__INDEX__', idx);
                });
                clone.querySelector('.js-remove-row').addEventListener('click', function (e) {
                    e.target.closest('tr').remove();
                });

                var tr = clone.querySelector('tr');
                document.getElementById('itens-tbody').appendChild(clone);
                ligarLinha(tr);
                tr.querySelector('.js-categoria').focus();
            }

            document.getElementById('btn-add-row').addEventListener('click', adicionarLinha);
            adicionarLinha();
        })();
    </script>
}
