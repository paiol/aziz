@model List<ComparacaoPropostas.Models.Entities.ItemPropostaEmpreiteiro>
@{
    var proposta = (ComparacaoPropostas.Models.Entities.PropostaEmpreiteiro)ViewBag.PropostaEmpreiteiro;
    ViewData["Title"] = "Itens da Proposta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Itens da Proposta — @proposta.Empreiteiro</h2>
</div>

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-3 align-items-end">
        <form asp-action="ImportarExcel" asp-route-propostaEmpreiteiroId="@proposta.Id" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-end">
            <div>
                <label class="form-label mb-1">Carregar ficheiro Excel preenchido pelo empreiteiro</label>
                <input type="file" name="ficheiro" accept=".xlsx" class="form-control form-control-sm" required />
            </div>
            <button type="submit" class="btn btn-subtle-success btn-sm">
                <span class="fas fa-upload me-1"></span> Importar
            </button>
        </form>
        <form asp-action="ExportarExcel" asp-route-propostaEmpreiteiroId="@proposta.Id" method="post">
            <button type="submit" class="btn btn-subtle-primary btn-sm">
                <span class="fas fa-download me-1"></span> Descarregar Modelo (Excel)
            </button>
        </form>
    </div>
</div>

<form asp-action="EditarTodos" asp-route-propostaEmpreiteiroId="@proposta.Id" method="post">
    <div class="card mb-3">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th style="width:100px">Quantidade</th>
                        <th style="width:160px">Preço Unitário</th>
                        <th style="width:140px">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.ItemMQT.NaoPrevisto ? "table-warning" : "")">
                            <td>
                                <input type="hidden" name="itemId" value="@item.Id" />
                                @item.ItemMQT.Descricao
                                @if (!string.IsNullOrWhiteSpace(item.ItemMQT.Unidade))
                                {
                                    <span class="text-body-tertiary"> (@item.ItemMQT.Unidade)</span>
                                }
                                @if (item.ItemMQT.NaoPrevisto)
                                {
                                    <span class="badge bg-warning text-dark ms-1"><i class="fas fa-triangle-exclamation me-1"></i>Não previsto</span>
                                }
                            </td>
                            <td><input type="number" step="0.001" name="quantidade" value="@item.QuantidadeFornecida" class="form-control form-control-sm" /></td>
                            <td><input type="number" step="0.01" name="preco" value="@item.PrecoUnitario" class="form-control form-control-sm" /></td>
                            <td>@item.Subtotal.ToString("C")</td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="4" class="text-body-tertiary">Ainda não há itens nesta proposta.</td></tr>
                    }
                </tbody>
                @if (Model.Count > 0)
                {
                    <tfoot>
                        <tr class="fw-bold border-top border-2">
                            <td colspan="3">Total Geral</td>
                            <td>@Model.Where(i => i.Incluido).Sum(i => i.Subtotal).ToString("C")</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>

    @if (Model.Count > 0)
    {
        <button type="submit" class="btn btn-primary">Guardar Itens</button>
    }
    <a class="btn btn-subtle-secondary" asp-controller="ProjetosObra" asp-action="Details" asp-route-id="@proposta.ProjetoObraId">Voltar ao Projeto</a>
</form>
