@model ComparacaoPropostas.ViewModels.PropostasEmpreiteiro.ConfirmarImportacaoMQTVM
@{
    ViewData["Title"] = "Confirmar Itens do Excel";
}

<h2>Confirmar Itens — @Model.Empreiteiro</h2>
<p class="text-body-tertiary">
    Estes itens do ficheiro Excel têm um nome diferente de qualquer item do Mapa de Quantidades.
    Para cada um, confirma se é o <strong>mesmo item do MQT</strong> (só com nomenclatura diferente) ou se é
    mesmo um <strong>item diferente</strong>, que não estava previsto — nesse caso fica marcado com um aviso.
</p>

<form asp-action="ConfirmarImportacao" method="post">
    <input type="hidden" asp-for="PropostaEmpreiteiroId" />

    @for (var i = 0; i < Model.Itens.Count; i++)
    {
        var linha = Model.Itens[i];
        <div class="card mb-3 border-warning">
            <div class="card-body">
                <input type="hidden" asp-for="Itens[i].NomeItem" />
                <input type="hidden" asp-for="Itens[i].QuantidadeFornecida" />
                <input type="hidden" asp-for="Itens[i].PrecoUnitario" />

                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                    <div>
                        <span class="badge bg-warning text-dark mb-1"><i class="fas fa-triangle-exclamation me-1"></i>Nome não reconhecido</span>
                        <h5 class="mb-0">@linha.NomeItem</h5>
                        <span class="text-body-tertiary small">Quantidade: @linha.QuantidadeFornecida — Preço: @linha.PrecoUnitario.ToString("C")</span>
                    </div>
                </div>

                <label class="form-label">É o mesmo item que</label>
                <select asp-for="Itens[i].EscolhaItemMQTId" class="form-select">
                    <option value="">— Item diferente (não previsto no MQT) —</option>
                    @foreach (var opcao in Model.ItensMQTDisponiveis)
                    {
                        if (opcao.ItemMQTId == linha.SugestaoItemMQTId)
                        {
                            <option value="@opcao.ItemMQTId" selected="selected">@opcao.Descricao (sugestão)</option>
                        }
                        else
                        {
                            <option value="@opcao.ItemMQTId">@opcao.Descricao</option>
                        }
                    }
                </select>
            </div>
        </div>
    }

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Confirmar Importação</button>
        <a class="btn btn-subtle-secondary" asp-action="Index" asp-route-propostaEmpreiteiroId="@Model.PropostaEmpreiteiroId">Cancelar</a>
    </div>
</form>
