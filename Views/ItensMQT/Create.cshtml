@model ComparacaoPropostas.ViewModels.ItensMQT.NovosItensMQTVM
@{
    ViewData["Title"] = "Adicionar Itens ao MQT";
}

<h2>Adicionar Itens — @ViewBag.ProjetoObraNome</h2>
<p class="text-body-tertiary">Adiciona quantas linhas precisares com o botão "+".</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Create" method="post">
    <input type="hidden" name="ProjetoObraId" value="@Model.ProjetoObraId" />

    <div class="card">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th style="width:140px">Código</th>
                        <th style="min-width:260px">Descrição</th>
                        <th style="width:120px">Unidade</th>
                        <th style="width:120px">Quantidade</th>
                        <th style="width:50px"></th>
                    </tr>
                </thead>
                <tbody id="itens-tbody"></tbody>
            </table>
        </div>
        <div class="card-footer">
            <button type="button" id="btn-add-row" class="btn btn-sm btn-subtle-primary">
                <span class="fas fa-plus me-1"></span> Adicionar Linha
            </button>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar Itens</button>
        <a asp-action="Index" asp-route-projetoObraId="@Model.ProjetoObraId" class="btn btn-subtle-secondary">Cancelar</a>
    </div>
</form>

<template id="item-row-template">
    <tr>
        <td>
            <input type="hidden" name="Itens.Index" value="__INDEX__" class="js-row-index" />
            <input type="text" name="Itens[__INDEX__].CodigoIndexacao" class="form-control form-control-sm" />
        </td>
        <td><input type="text" name="Itens[__INDEX__].Descricao" class="form-control form-control-sm" required /></td>
        <td><input type="text" name="Itens[__INDEX__].Unidade" class="form-control form-control-sm" /></td>
        <td><input type="number" step="0.001" value="1" name="Itens[__INDEX__].Quantidade" class="form-control form-control-sm" required /></td>
        <td class="text-end">
            <button type="button" class="btn btn-sm btn-subtle-danger js-remove-row"><span class="fas fa-xmark"></span></button>
        </td>
    </tr>
</template>

@section Scripts {
    <script>
        (function () {
            var rowCount = 0;

            function adicionarLinha() {
                var tpl = document.getElementById('item-row-template');
                var clone = tpl.content.cloneNode(true);
                var idx = 'r' + (rowCount++);

                clone.querySelector('.js-row-index').value = idx;
                clone.querySelectorAll('[name]').forEach(function (el) {
                    el.name = el.name.replace('__INDEX__', idx);
                });
                clone.querySelector('.js-remove-row').addEventListener('click', function (e) {
                    e.target.closest('tr').remove();
                });

                document.getElementById('itens-tbody').appendChild(clone);
            }

            document.getElementById('btn-add-row').addEventListener('click', adicionarLinha);
            adicionarLinha();
        })();
    </script>
}
