@model List<ComparacaoPropostas.Models.Entities.ItemMQT>
@{
    var projeto = (ComparacaoPropostas.Models.Entities.ProjetoObra)ViewBag.ProjetoObra;
    ViewData["Title"] = "Mapa de Quantidades";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Mapa de Quantidades — @projeto.Designacao</h2>
    <a class="btn btn-primary" asp-action="Create" asp-route-projetoObraId="@projeto.Id"><span class="fas fa-plus me-1"></span> Adicionar Itens</a>
</div>

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-3 align-items-end">
        <form asp-action="ImportarExcel" asp-route-projetoObraId="@projeto.Id" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-end">
            <div>
                <label class="form-label mb-1">Ou carregar ficheiro Excel do Mapa de Quantidades</label>
                <input type="file" name="ficheiro" accept=".xlsx" class="form-control form-control-sm" required />
            </div>
            <button type="submit" class="btn btn-subtle-success btn-sm">
                <span class="fas fa-upload me-1"></span> Importar
            </button>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th>Unidade</th>
                    <th>Quantidade</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.NaoPrevisto ? "table-warning" : "")">
                        <td>@(item.CodigoIndexacao ?? "-")</td>
                        <td>
                            @item.Descricao
                            @if (item.NaoPrevisto)
                            {
                                <span class="badge bg-warning text-dark ms-1" title="Item adicionado depois, não estava no MQT original">
                                    <i class="fas fa-triangle-exclamation me-1"></i>Não previsto
                                </span>
                            }
                        </td>
                        <td>@(item.Unidade ?? "-")</td>
                        <td>@item.Quantidade.ToString("0.###")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-subtle-secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                            <button type="button" class="btn btn-sm btn-subtle-danger js-delete-btn"
                                    data-url="@Url.Action("Delete", new { id = item.Id })" data-id="@item.Id">Apagar</button>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-body-tertiary">Ainda não há itens no Mapa de Quantidades.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<a class="btn btn-subtle-secondary" asp-controller="ProjetosObra" asp-action="Details" asp-route-id="@projeto.Id">Voltar ao Projeto</a>
