@model List<ComparacaoPropostas.Models.Entities.ItemPedido>
@{
    var processo = (ComparacaoPropostas.Models.Entities.Processo)ViewBag.Processo;
    ViewData["Title"] = "Itens a Pedir";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Itens a Pedir</h2>
        <p class="text-body-tertiary mb-0">@processo.Nome — Fornecedor: @processo.Fornecedor</p>
    </div>
    <div>
        <a class="btn btn-primary" asp-action="Create" asp-route-processoId="@processo.Id">
            <span class="fas fa-plus me-1"></span> Adicionar Itens
        </a>
        <a class="btn btn-subtle-secondary" asp-controller="Processos" asp-action="Details" asp-route-id="@processo.Id">Voltar ao Processo</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-3 align-items-end">
        <a class="btn btn-subtle-primary" asp-action="ExportarExcel" asp-route-processoId="@processo.Id">
            <span class="fas fa-file-excel me-1"></span> Descarregar Pedido (Excel)
        </a>
        <form asp-action="ImportarResposta" asp-route-processoId="@processo.Id" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-end">
            <div>
                <label class="form-label mb-1">Importar resposta preenchida</label>
                <input type="file" name="ficheiro" accept=".xlsx" class="form-control form-control-sm" required />
            </div>
            <button type="submit" class="btn btn-subtle-success btn-sm">
                <span class="fas fa-upload me-1"></span> Importar
            </button>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Ainda não há itens a pedir. Adiciona itens antes de descarregar o Excel.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantidade Solicitada</th>
                        <th>Observação</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ItemMaterial.NomeItem</td>
                            <td>@item.QuantidadeSolicitada</td>
                            <td>@item.Observacao</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-subtle-danger js-delete-btn"
                                        data-url="@Url.Action("Delete", new { id = item.Id })" data-id="@item.Id">Apagar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
