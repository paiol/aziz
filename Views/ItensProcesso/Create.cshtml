@model ComparacaoPropostas.ViewModels.ItensProcesso.NovosItensProcessoVM
@{
    ViewData["Title"] = "Adicionar Itens a Pedir";
}

<h2>Adicionar Itens a Pedir — @ViewBag.ProcessoNome</h2>
<p class="text-body-tertiary">Escreve para procurar um item nos catálogos (Item Energia, MBB, FBB, Core e Itens/Materiais). Depois de gravar, podes descarregar o Excel para enviar ao fornecedor.</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Create" method="post">
    <input type="hidden" name="ProcessoId" value="@Model.ProcessoId" />

    <div class="card">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th style="min-width:320px">Item</th>
                        <th style="width:160px">Quantidade Solicitada</th>
                        <th>Observação</th>
                        <th style="width:50px"></th>
                    </tr>
                </thead>
                <tbody id="itens-tbody"></tbody>
            </table>
        </div>
        <div class="card-footer">
            <button type="button" id="btn-add-row" class="btn btn-sm btn-subtle-primary">
                <span class="fas fa-plus me-1"></span> Adicionar Linha
            </button>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar Itens</button>
        <a asp-action="Index" asp-route-processoId="@Model.ProcessoId" class="btn btn-subtle-secondary">Cancelar</a>
    </div>
</form>

<template id="item-row-template">
    <tr>
        <td>
            <input type="hidden" name="Itens.Index" value="__INDEX__" class="js-row-index" />
            <input type="hidden" name="Itens[__INDEX__].ChaveItem" class="js-chave-item" required />
            <div class="position-relative">
                <input type="text" class="form-control form-control-sm js-item-search" placeholder="Escreva para procurar (ex: disjuntor, antena...)" autocomplete="off" required />
                <div class="list-group position-absolute w-100 shadow-sm js-item-resultados" style="z-index:1000; max-height:260px; overflow-y:auto; display:none;"></div>
            </div>
        </td>
        <td><input type="number" step="0.001" value="1" name="Itens[__INDEX__].QuantidadeSolicitada" class="form-control form-control-sm" required /></td>
        <td><input type="text" name="Itens[__INDEX__].Observacao" class="form-control form-control-sm" /></td>
        <td class="text-end">
            <button type="button" class="btn btn-sm btn-subtle-danger js-remove-row"><span class="fas fa-xmark"></span></button>
        </td>
    </tr>
</template>

@section Scripts {
    <script>
        (function () {
            var rowCount = 0;
            var areaSugerida = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)(ViewBag.AreaSugerida ?? "")));
            var buscarUrl = '@Url.Action("BuscarItens")';
            var debounceTimer = null;

            function origemBadge(origem) {
                var cores = { 'Catálogo': 'secondary', 'Energia': 'warning text-dark', 'MBB': 'info text-dark', 'FBB': 'primary', 'Core': 'dark' };
                var cor = cores[origem] || 'secondary';
                return '<span class="badge bg-' + cor + ' ms-2">' + origem + '</span>';
            }

            function renderResultados(container, resultados, onEscolher) {
                container.innerHTML = '';
                if (resultados.length === 0) {
                    container.style.display = 'none';
                    return;
                }
                resultados.forEach(function (r) {
                    var el = document.createElement('button');
                    el.type = 'button';
                    el.className = 'list-group-item list-group-item-action py-2';
                    var detalhe = [r.categoria, r.unidade, r.dominio].filter(Boolean).join(' · ');
                    el.innerHTML = '<div class="d-flex justify-content-between align-items-center">' +
                        '<div><div>' + r.nome + '</div>' +
                        (detalhe ? '<small class="text-body-tertiary">' + detalhe + '</small>' : '') +
                        '</div>' + origemBadge(r.origem) + '</div>';
                    el.addEventListener('click', function () { onEscolher(r); });
                    container.appendChild(el);
                });
                container.style.display = 'block';
            }

            function buscar(termo, dominio, callback) {
                var url = buscarUrl + '?termo=' + encodeURIComponent(termo || '') + '&dominio=' + encodeURIComponent(dominio || '');
                fetch(url).then(function (resp) { return resp.json(); }).then(callback).catch(function () { callback([]); });
            }

            function ligarLinha(tr) {
                var input = tr.querySelector('.js-item-search');
                var chaveInput = tr.querySelector('.js-chave-item');
                var resultados = tr.querySelector('.js-item-resultados');

                function escolher(r) {
                    chaveInput.value = r.chave;
                    input.value = r.nome;
                    resultados.style.display = 'none';
                }

                input.addEventListener('input', function () {
                    chaveInput.value = '';
                    clearTimeout(debounceTimer);
                    var termo = input.value.trim();
                    debounceTimer = setTimeout(function () {
                        buscar(termo, areaSugerida, function (lista) { renderResultados(resultados, lista, escolher); });
                    }, 250);
                });

                input.addEventListener('focus', function () {
                    if (!input.value.trim() && areaSugerida) {
                        buscar('', areaSugerida, function (lista) { renderResultados(resultados, lista, escolher); });
                    }
                });

                document.addEventListener('click', function (e) {
                    if (!tr.contains(e.target)) resultados.style.display = 'none';
                });
            }

            function adicionarLinha() {
                var tpl = document.getElementById('item-row-template');
                var clone = tpl.content.cloneNode(true);
                var idx = 'r' + (rowCount++);

                clone.querySelector('.js-row-index').value = idx;
                clone.querySelectorAll('[name]').forEach(function (el) {
                    el.name = el.name.replace('__INDEX__', idx);
                });
                clone.querySelector('.js-remove-row').addEventListener('click', function (e) {
                    e.target.closest('tr').remove();
                });

                var tr = clone.querySelector('tr');
                document.getElementById('itens-tbody').appendChild(clone);
                ligarLinha(tr);
                tr.querySelector('.js-item-search').focus();
            }

            document.getElementById('btn-add-row').addEventListener('click', adicionarLinha);
            adicionarLinha();
        })();
    </script>
}
