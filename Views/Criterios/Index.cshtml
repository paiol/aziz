@using ComparacaoPropostas.Models.Entities.Enums
@model List<ComparacaoPropostas.Models.Entities.Criterio>
@{
    var processo = (ComparacaoPropostas.Models.Entities.Processo)ViewBag.Processo;
    var somaPesos = Model.Sum(c => c.Peso);
    ViewData["Title"] = "Critérios do Processo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Critérios de Avaliação</h2>
        <p class="text-body-tertiary mb-0">@processo.Nome — soma dos pesos: @somaPesos.ToString("0.##")%</p>
    </div>
    <div>
        <a class="btn btn-primary" asp-action="Create" asp-route-processoId="@processo.Id">
            <span class="fas fa-plus me-1"></span> Adicionar Critérios
        </a>
        <a class="btn btn-subtle-secondary" asp-controller="Processos" asp-action="Details" asp-route-id="@processo.Id">Voltar ao Processo</a>
    </div>
</div>

@if (somaPesos != 100)
{
    <div class="alert alert-warning">A soma dos pesos deveria idealmente ser 100% — atualmente é @somaPesos.ToString("0.##")%.</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">Este processo ainda não tem critérios definidos.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Critério</th>
                        <th>Categoria</th>
                        <th style="width:120px">Peso</th>
                        <th style="width:180px">Cálculo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Nome</td>
                            <td>@c.Categoria</td>
                            <td>@c.Peso.ToString("0.##")%</td>
                            <td>
                                @if (c.TipoAutomatico == TipoCriterioAutomatico.Nenhum)
                                {
                                    <span class="badge bg-secondary">Manual (estrelas)</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary"><i class="fas fa-robot me-1"></i>Automático — @c.TipoAutomatico</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-subtle-secondary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                                <button type="button" class="btn btn-sm btn-subtle-danger js-delete-btn"
                                        data-url="@Url.Action("Delete", new { id = c.Id })" data-id="@c.Id">Apagar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
