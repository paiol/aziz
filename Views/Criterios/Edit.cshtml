@model ComparacaoPropostas.Models.Entities.Criterio
@{
    ViewData["Title"] = "Editar Critério";
}

<h2>Editar Critério</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ProcessoId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Categoria" class="form-label"></label>
                    <input asp-for="Categoria" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Peso" class="form-label"></label>
                    <input asp-for="Peso" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-12">
                    <label asp-for="Descricao" class="form-label"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" asp-route-processoId="@Model.ProcessoId" class="btn btn-subtle-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
