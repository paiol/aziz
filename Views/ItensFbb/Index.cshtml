@model List<ComparacaoPropostas.Models.Entities.ItemFbb>
@{
    ViewData["Title"] = "Item FBB";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Item FBB</h2>
    <a class="btn btn-primary" asp-action="Create"><span class="fas fa-plus me-1"></span> Novo Item</a>
</div>

<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">Importar Catálogo (Excel)</h5></div>
    <div class="card-body">
        <form asp-action="ImportarExcel" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label mb-1">Ficheiro Excel</label>
                <input type="file" name="ficheiro" accept=".xlsx" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-subtle-primary btn-sm w-100">
                    <span class="fas fa-upload me-1"></span> Importar
                </button>
            </div>
        </form>
        <div class="form-text mt-2">Lê a folha "Necessidade total" (ou a primeira folha) e usa as colunas "Item", "Categoria" e "Unidade" pelo nome do cabeçalho. Itens com o mesmo nome já existente são ignorados.</div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-hover data-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Categoria</th>
                    <th>Unidade</th>
                    <th>Domínio</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.Tipo</td>
                        <td>@item.Categoria</td>
                        <td>@item.Unidade</td>
                        <td>@item.Dominio</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-subtle-secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                            <button type="button" class="btn btn-sm btn-subtle-danger js-delete-btn"
                                    data-url="@Url.Action("Delete", new { id = item.Id })" data-id="@item.Id">Apagar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
