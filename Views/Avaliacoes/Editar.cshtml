@model ComparacaoPropostas.ViewModels.Avaliacoes.AvaliacaoFormVM
@{
    ViewData["Title"] = "Avaliar Proposta";
}

<h2>Avaliar Proposta — @Model.PropostaFornecedor</h2>

@if (Model.Itens.Count == 0)
{
    <div class="alert alert-warning">
        Este processo ainda não tem critérios atribuídos.
        <a asp-controller="ProcessoCriterios" asp-action="Gerenciar" asp-route-processoId="@Model.ProcessoId">Atribuir critérios</a> primeiro.
    </div>
}
else
{
    <form asp-action="Editar" method="post">
        <input type="hidden" asp-for="PropostaId" />
        <input type="hidden" asp-for="PropostaFornecedor" />
        <input type="hidden" asp-for="ProcessoId" />

        <div class="card">
            <div class="card-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Critério</th>
                            <th style="width:90px">Peso</th>
                            <th style="width:140px">Nota (0-10)</th>
                            <th>Comentário</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Itens.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" asp-for="Itens[i].ProcessoCriterioId" />
                                    <input type="hidden" asp-for="Itens[i].CriterioNome" />
                                    <input type="hidden" asp-for="Itens[i].Peso" />
                                    @Model.Itens[i].CriterioNome
                                </td>
                                <td>@Model.Itens[i].Peso.ToString("0.##")%</td>
                                <td>
                                    <input type="number" step="0.1" min="0" max="10" class="form-control form-control-sm" asp-for="Itens[i].Nota" />
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" asp-for="Itens[i].Comentario" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Guardar Avaliação</button>
            <a asp-controller="Processos" asp-action="Details" asp-route-id="@Model.ProcessoId" class="btn btn-subtle-secondary">Cancelar</a>
        </div>
    </form>
}
