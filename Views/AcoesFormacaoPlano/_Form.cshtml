@using ComparacaoPropostas.Models.Entities.Enums
@model ComparacaoPropostas.Models.Entities.AcaoFormacaoPlano
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-2">
        <label asp-for="Prioridade" class="form-label"></label>
        <select asp-for="Prioridade" class="form-select">
            <option value="1">1 — Mínimo</option>
            <option value="2">2 — Alargado</option>
            <option value="3">3 — Opcional</option>
        </select>
    </div>
    <div class="col-md-2">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" class="form-select" asp-items="Html.GetEnumSelectList<TipoAcaoFormacao>()"></select>
    </div>
    <div class="col-md-6">
        <label asp-for="Acao" class="form-label"></label>
        <input asp-for="Acao" class="form-control" required />
        <span asp-validation-for="Acao" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="Ano" class="form-label"></label>
        <input asp-for="Ano" class="form-control" type="number" min="2000" max="2100" />
    </div>
    <div class="col-md-4">
        <label asp-for="Datas" class="form-label"></label>
        <input asp-for="Datas" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Local" class="form-label"></label>
        <input asp-for="Local" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Formato" class="form-label"></label>
        <input asp-for="Formato" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="LigacaoProjetos" class="form-label"></label>
        <textarea asp-for="LigacaoProjetos" class="form-control" rows="2"></textarea>
    </div>
    <div class="col-md-2">
        <label asp-for="NumeroPessoas" class="form-label"></label>
        <input asp-for="NumeroPessoas" class="form-control" type="number" min="0" />
    </div>
    <div class="col-md-2">
        <label asp-for="Dias" class="form-label"></label>
        <input asp-for="Dias" class="form-control" type="text" inputmode="decimal" />
    </div>
    <div class="col-md-2">
        <label asp-for="InscricaoPorPessoa" class="form-label"></label>
        <input asp-for="InscricaoPorPessoa" class="form-control" type="text" inputmode="decimal" />
    </div>
    <div class="col-md-2">
        <label asp-for="PassagemPorPessoa" class="form-label"></label>
        <input asp-for="PassagemPorPessoa" class="form-control" type="text" inputmode="decimal" />
    </div>
    <div class="col-md-2">
        <label asp-for="EstadiaDia" class="form-label"></label>
        <input asp-for="EstadiaDia" class="form-control" type="text" inputmode="decimal" />
    </div>
    <div class="col-md-2">
        <label asp-for="AjudaCustoDia" class="form-label"></label>
        <input asp-for="AjudaCustoDia" class="form-control" type="text" inputmode="decimal" />
    </div>
    <div class="col-12">
        <div class="form-text">Total (CVE) = Nº pessoas × (Inscrição + Passagem + Dias × (Estadia + Ajuda de custo)).</div>
    </div>
    <div class="col-md-2">
        <div class="form-check mt-2">
            <input asp-for="NoPlano" class="form-check-input" />
            <label asp-for="NoPlano" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-md-5">
        <label asp-for="Participantes" class="form-label"></label>
        <input asp-for="Participantes" class="form-control" />
    </div>
    <div class="col-md-5">
        <label asp-for="Fonte" class="form-label"></label>
        <input asp-for="Fonte" class="form-control" placeholder="https://…" />
    </div>
    <div class="col-12">
        <label asp-for="Observacoes" class="form-label"></label>
        <textarea asp-for="Observacoes" class="form-control" rows="2"></textarea>
    </div>
</div>
