@using ComparacaoPropostas.Helper
@using ComparacaoPropostas.Models.Entities
@using ComparacaoPropostas.Models.Entities.Enums
@using ComparacaoPropostas.Services.Stock
@model ComparacaoPropostas.Models.Entities.MaterialStock
@{
    var m = Model;
    ViewData["Title"] = m.Codigo;
    var porArea = StockCalculos.SaldoPorArea(m.Movimentos);
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">@m.Codigo <span class="text-body-tertiary fw-normal" style="font-size: 1rem">@m.Modelo</span></h2>
        <span class="text-body-tertiary">@m.Descricao</span>
        <div><a asp-action="Index" class="small"><span class="fas fa-arrow-left me-1"></span>Voltar ao stock</a></div>
    </div>
    <a class="btn btn-subtle-warning" asp-action="NovaSaida" asp-route-materialStockId="@m.Id"><span class="fas fa-dolly me-1"></span> Registar saída</a>
</div>

<div class="row g-3 mb-3">
    @foreach (var a in Enum.GetValues<AreaDepartamento>())
    {
        var v = porArea.GetValueOrDefault(a);
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body py-2">
                <span class="text-body-tertiary d-block small">@a.ToLabel()</span>
                <span class="fw-semibold @(v == 0 ? "text-body-tertiary" : "")" style="font-size: 1.25rem">@v.ToQtd() <span class="small">@m.Unidade</span></span>
            </div></div>
        </div>
    }
</div>

@if (m.DivergenciasNome.Count > 0)
{
    var pendentes = m.DivergenciasNome.Where(d => d.Estado == EstadoDivergenciaNome.Pendente).ToList();
    <div class="card mb-3 @(pendentes.Count > 0 ? "border-warning" : "")">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                @if (pendentes.Count > 0) { <i class="fas fa-triangle-exclamation text-warning me-1"></i> }
                Outros nomes deste material
            </h5>
            <span class="small text-body-tertiary">Mesmo código (ID) <strong>@m.Codigo</strong> — o catálogo chama-lhe "@m.Descricao"</span>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-sm mb-0">
                <thead><tr><th>Alerta</th><th>Nome recebido</th><th>Origem</th><th>Nome no catálogo na altura</th><th>Data</th><th>Estado</th><th style="width: 1%"></th></tr></thead>
                <tbody>
                    @foreach (var d in m.DivergenciasNome.OrderBy(d => d.Estado != EstadoDivergenciaNome.Pendente).ThenByDescending(d => d.CriadoEm))
                    {
                        <tr class="@(d.Estado == EstadoDivergenciaNome.Pendente ? "table-warning" : "")">
                            <td>#@d.Id</td>
                            <td class="fw-semibold">@d.NomeRecebido</td>
                            <td class="small">
                                @d.Origem.ToLabel()
                                @if (d.EntradaStockId != null) { <a class="d-block" asp-action="Entrada" asp-route-id="@d.EntradaStockId">@d.Referencia</a> }
                                else if (d.InventarioStockId != null) { <a class="d-block" asp-controller="Inventario" asp-action="Details" asp-route-id="@d.InventarioStockId">@d.Referencia</a> }
                                else if (d.Referencia != null) { <span class="d-block text-body-tertiary">@d.Referencia</span> }
                            </td>
                            <td class="small">@d.NomeCatalogo</td>
                            <td class="small">@d.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td><span class="badge @(d.Estado == EstadoDivergenciaNome.Pendente ? "bg-warning text-dark" : "bg-secondary")">@d.Estado.ToLabel()</span></td>
                            <td class="text-end">
                                @if (d.Estado == EstadoDivergenciaNome.Pendente)
                                {
                                    <form id="nome-@d.Id" asp-action="ResolverNome" asp-route-id="@d.Id" method="post" class="d-none">
                                        <input type="hidden" name="voltarPara" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                    </form>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-subtle-secondary btn-menu-acoes" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Opções"><i class="fas fa-ellipsis"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><button type="submit" form="nome-@d.Id" name="usarRecebido" value="false" class="dropdown-item"><i class="fas fa-check me-2"></i>Manter nome do catálogo</button></li>
                                            <li><button type="submit" form="nome-@d.Id" name="usarRecebido" value="true" class="dropdown-item"><i class="fas fa-pen-to-square me-2"></i>Usar este nome no catálogo</button></li>
                                        </ul>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="form-text">Os nomes já decididos ficam conhecidos para este código e não voltam a gerar alerta.</div>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">Dados do material</h5></div>
    <div class="card-body">
        <form asp-action="EditarMaterial" asp-route-id="@m.Id" method="post" class="row g-3">
            <div class="col-md-6"><label class="form-label" for="descricao">Descrição</label><input id="descricao" name="descricao" class="form-control" value="@m.Descricao" required /></div>
            <div class="col-md-2"><label class="form-label" for="modelo">Modelo</label><input id="modelo" name="modelo" class="form-control" value="@m.Modelo" maxlength="100" /></div>
            <div class="col-md-1"><label class="form-label" for="unidade">Unidade</label><input id="unidade" name="unidade" class="form-control" value="@m.Unidade" maxlength="20" /></div>
            <div class="col-md-2"><label class="form-label" for="fabricante">Fabricante</label><input id="fabricante" name="fabricante" class="form-control" value="@m.Fabricante" maxlength="100" /></div>
            <div class="col-md-1"><label class="form-label" for="stockMinimo">Mínimo</label><input id="stockMinimo" name="stockMinimo" class="form-control" value="@m.StockMinimo?.ToString("0.###", new System.Globalization.CultureInfo("pt-PT"))" inputmode="decimal" /></div>
            <div class="col-md-3"><label class="form-label" for="precoUnitario">Preço unitário (CVE)</label><input id="precoUnitario" name="precoUnitario" class="form-control" value="@m.PrecoUnitario?.ToString("0.##", new System.Globalization.CultureInfo("pt-PT"))" inputmode="decimal" /></div>
            <div class="col-md-3"><label class="form-label" for="diasParado">Alarme de stock parado (dias)</label><input id="diasParado" name="diasParado" type="number" min="1" class="form-control" value="@m.DiasParado" placeholder="180" /></div>
            <div class="col-md-6 form-text align-self-end">O preço dá os valores em CVE no Painel de Stock. Os alarmes avisam quando o stock fica abaixo do mínimo, esgota ou fica parado (sem saídas) mais do que estes dias.</div>
            <div class="col-12"><button type="submit" class="btn btn-sm btn-subtle-primary">Guardar</button></div>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">Movimentos</h5></div>
    <div class="card-body table-responsive">
        <table class="table table-sm mb-0 data-table">
            <thead>
                <tr><th>Data</th><th>Tipo</th><th>Área</th><th class="text-end">Qtd.</th><th>Documento</th><th>Projeto Capex</th><th>Site / destino</th></tr>
            </thead>
            <tbody>
                @foreach (var mv in m.Movimentos.OrderByDescending(x => x.Data).ThenByDescending(x => x.Id))
                {
                    <tr>
                        <td data-order="@mv.Data.ToString("yyyy-MM-dd")">@mv.Data.ToString("dd/MM/yyyy")</td>
                        <td><span class="@mv.Tipo.ToBadgeClass()">@mv.Tipo.ToLabel()</span></td>
                        <td>@mv.Area.ToLabel()</td>
                        <td class="text-end">@StockCalculos.Efeito(mv).ToQtd()</td>
                        <td>@if (mv.Entrada != null) { <a asp-action="Entrada" asp-route-id="@mv.Entrada.Id">@mv.Entrada.Numero</a> } else { <span>-</span> }</td>
                        <td class="small">@if (mv.ProjetoPlano != null) { <a asp-controller="ProjetosPlano" asp-action="Details" asp-route-id="@mv.ProjetoPlano.Id">@mv.ProjetoPlano.Nome</a> } else { <span>-</span> }</td>
                        <td class="small">@(string.Join(" · ", new[] { mv.Site, mv.Destino }.Where(x => !string.IsNullOrWhiteSpace(x))))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (m.NumerosSerie.Count > 0)
{
    <div class="card">
        <div class="card-header"><h5 class="mb-0">Números de série (@m.NumerosSerie.Count(s => s.Estado == EstadoNumeroSerie.EmArmazem) em armazém de @m.NumerosSerie.Count)</h5></div>
        <div class="card-body table-responsive">
            <table class="table table-sm mb-0 data-table">
                <thead><tr><th>Nº de série</th><th>Área</th><th>Caixa</th><th>Estado</th><th>Saída</th></tr></thead>
                <tbody>
                    @foreach (var s in m.NumerosSerie.OrderBy(s => s.Estado).ThenBy(s => s.Serie))
                    {
                        <tr>
                            <td class="font-monospace">@s.Serie</td>
                            <td>@s.Area.ToLabel()</td>
                            <td>@(s.Caixa ?? "-")</td>
                            <td><span class="badge @(s.Estado == EstadoNumeroSerie.EmArmazem ? "bg-success" : "bg-secondary")">@s.Estado.ToLabel()</span></td>
                            <td class="small">@(s.MovimentoSaida == null ? "-" : $"{s.MovimentoSaida.Data:dd/MM/yyyy} {s.MovimentoSaida.Site ?? s.MovimentoSaida.Destino}")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
