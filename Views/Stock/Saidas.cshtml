@using ComparacaoPropostas.Helper
@using ComparacaoPropostas.Models.Entities.Enums
@model List<ComparacaoPropostas.Models.Entities.MovimentoStock>
@{
    ViewData["Title"] = "Saídas de stock";
    var area = (AreaDepartamento?)ViewBag.Area;
    var seriesPorSaida = (Dictionary<int, List<string>>)ViewBag.SeriesPorSaida;
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Saídas de stock</h2>
        <a asp-action="Index" class="small"><span class="fas fa-arrow-left me-1"></span>Voltar ao stock</a>
    </div>
    <a class="btn btn-warning" asp-action="NovaSaida" asp-route-area="@area"><span class="fas fa-dolly me-1"></span> Registar saída</a>
</div>

<form method="get" class="mb-3">
    <input type="hidden" name="projetoPlanoId" value="@ViewBag.ProjetoPlanoId" />
    <label for="f-area" class="form-label mb-1 small">Área</label>
    <select id="f-area" name="area" class="form-select form-select-sm" style="max-width: 14rem" onchange="this.form.submit()"
            asp-items="Enum.GetValues<AreaDepartamento>().Select(a => new SelectListItem(a.ToLabel(), a.ToString(), a == area))">
        <option value="" selected="@(area == null)">Todas</option>
    </select>
</form>

<div class="card">
    <div class="card-body table-responsive">
        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">Ainda não há saídas registadas.</div>
        }
        else
        {
            <table class="table table-hover table-sm data-table">
                <thead>
                    <tr><th>Data</th><th>Área</th><th>Material</th><th class="text-end">Qtd.</th><th>Projeto Capex</th><th>Site / destino</th><th>Responsável</th><th>Nºs de série</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td data-order="@m.Data.ToString("yyyy-MM-dd")">@m.Data.ToString("dd/MM/yyyy")</td>
                            <td>@m.Area.ToLabel()</td>
                            <td><a asp-action="Material" asp-route-id="@m.MaterialStockId">@m.Material.Codigo</a><div class="small text-body-tertiary">@m.Material.Descricao</div></td>
                            <td class="text-end">@m.Quantidade.ToQtd() @m.Material.Unidade</td>
                            <td class="small">@if (m.ProjetoPlano != null) { <a asp-controller="ProjetosPlano" asp-action="Details" asp-route-id="@m.ProjetoPlano.Id">@m.ProjetoPlano.Nome</a> } else { <span>-</span> }</td>
                            <td class="small">@(string.Join(" · ", new[] { m.Site, m.Destino }.Where(x => !string.IsNullOrWhiteSpace(x))))</td>
                            <td class="small">@(m.Responsavel ?? "-")</td>
                            <td class="small font-monospace">@(seriesPorSaida.TryGetValue(m.Id, out var s) ? string.Join(", ", s) : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
