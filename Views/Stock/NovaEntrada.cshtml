@using ComparacaoPropostas.Helper
@using ComparacaoPropostas.Models.Entities
@using ComparacaoPropostas.Models.Entities.Enums
@model ComparacaoPropostas.ViewModels.Stock.NovaEntradaVM
@{
    ViewData["Title"] = "Nova entrada de stock";
    var projetos = (List<SelectListItem>)ViewBag.ProjetosCapex;
    var pedidos = (List<SelectListItem>)ViewBag.Pedidos;
}

<h2>Nova entrada de stock</h2>
<p class="text-body-tertiary">Para compras da DEI (ou acertos manuais). Os Packing Lists da Huawei importam-se em <a asp-action="Entradas">Entradas</a>.</p>

<form asp-action="NovaEntrada" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="card mb-3">
        <div class="card-body row g-3">
            <div class="col-md-3">
                <label asp-for="Entrada.Tipo" class="form-label"></label>
                <select asp-for="Entrada.Tipo" class="form-select">
                    <option value="@TipoEntradaStock.CompraDei">Compra DEI</option>
                    <option value="@TipoEntradaStock.Manual">Manual</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Entrada.Area" class="form-label"></label>
                <select asp-for="Entrada.Area" class="form-select" asp-items="Html.GetEnumSelectList<AreaDepartamento>()"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="Entrada.Numero" class="form-label">Nº documento (guia / fatura)</label>
                <input asp-for="Entrada.Numero" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label asp-for="Entrada.Data" class="form-label"></label>
                <input asp-for="Entrada.Data" class="form-control" type="date" />
            </div>
            <div class="col-md-4">
                <label asp-for="Entrada.Fornecedor" class="form-label"></label>
                <input asp-for="Entrada.Fornecedor" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Entrada.ProjetoPlanoId" class="form-label"></label>
                <select asp-for="Entrada.ProjetoPlanoId" class="form-select" asp-items="projetos"><option value="">— sem projeto —</option></select>
            </div>
            <div class="col-md-4">
                <label asp-for="Entrada.PedidoPropostaId" class="form-label"></label>
                <select asp-for="Entrada.PedidoPropostaId" class="form-select" asp-items="pedidos"><option value="">— nenhum —</option></select>
            </div>
            <div class="col-md-4">
                <label asp-for="Entrada.Localizacao" class="form-label"></label>
                <input asp-for="Entrada.Localizacao" class="form-control" />
            </div>
            <div class="col-md-8">
                <label asp-for="Entrada.Observacoes" class="form-label"></label>
                <input asp-for="Entrada.Observacoes" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0">Materiais</h5><span class="small text-body-tertiary">Se o código já existir no stock, usa-se esse material. Números de série: separados por espaço ou vírgula.</span></div>
        <div class="card-body table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th style="width:14%">Código</th><th>Descrição</th><th style="width:8%">Un.</th><th style="width:10%">Qtd.</th><th style="width:28%">Nºs de série</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Model.Linhas.Count; i++)
                    {
                        <tr>
                            <td><input asp-for="Linhas[i].Codigo" class="form-control form-control-sm" /></td>
                            <td><input asp-for="Linhas[i].Descricao" class="form-control form-control-sm" /></td>
                            <td><input asp-for="Linhas[i].Unidade" class="form-control form-control-sm" placeholder="PCS" /></td>
                            <td><input asp-for="Linhas[i].Quantidade" class="form-control form-control-sm text-end" type="text" inputmode="decimal" /></td>
                            <td><input asp-for="Linhas[i].Series" class="form-control form-control-sm" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mb-4">
        <button type="submit" class="btn btn-primary"><span class="fas fa-save me-1"></span> Registar entrada</button>
        <a asp-action="Entradas" class="btn btn-subtle-secondary">Cancelar</a>
    </div>
</form>
