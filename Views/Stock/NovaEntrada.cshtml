@using ComparacaoPropostas.Helper
@using ComparacaoPropostas.Models.Entities
@using ComparacaoPropostas.Models.Entities.Enums
@model ComparacaoPropostas.ViewModels.Stock.NovaEntradaVM
@{
    ViewData["Title"] = "Nova entrada de stock";
    var projetos = (List<SelectListItem>)ViewBag.ProjetosCapex;
    var processos = (List<SelectListItem>)ViewBag.Processos;
    var fornecedores = (List<string>)ViewBag.Fornecedores;
}

<h2>Nova entrada de stock</h2>
<p class="text-body-tertiary">Para compras da DEI (ou acertos manuais). Os Packing Lists da Huawei importam-se em <a asp-action="Entradas">Entradas</a>.</p>

<form asp-action="NovaEntrada" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="card mb-3">
        <div class="card-body row g-3">
            <div class="col-md-3">
                <label asp-for="Entrada.Tipo" class="form-label"></label>
                <select asp-for="Entrada.Tipo" class="form-select">
                    <option value="@TipoEntradaStock.CompraDei">Compra DEI</option>
                    <option value="@TipoEntradaStock.Manual">Manual</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Entrada.Area" class="form-label"></label>
                <select asp-for="Entrada.Area" class="form-select" asp-items="Html.GetEnumSelectList<AreaDepartamento>()"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="Entrada.Numero" class="form-label">Nº documento (guia / fatura)</label>
                <input asp-for="Entrada.Numero" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label asp-for="Entrada.Data" class="form-label"></label>
                <input asp-for="Entrada.Data" class="form-control" type="date" />
            </div>
            <div class="col-md-4">
                <label asp-for="Entrada.Fornecedor" class="form-label"></label>
                <input asp-for="Entrada.Fornecedor" class="form-control" list="lista-fornecedores" />
                <datalist id="lista-fornecedores">@foreach (var fn in fornecedores) { <option value="@fn"></option> }</datalist>
            </div>
            <div class="col-md-4">
                <label asp-for="Entrada.ProjetoPlanoId" class="form-label"></label>
                <select asp-for="Entrada.ProjetoPlanoId" class="form-select" asp-items="projetos"><option value="">— sem projeto —</option></select>
            </div>
            <div class="col-md-4">
                <label asp-for="ProcessoId" class="form-label">Processo de compra (plataforma)</label>
                <select asp-for="ProcessoId" class="form-select" asp-items="processos"><option value="">— nenhum —</option></select>
                <div class="form-text">O projeto Capex e o fornecedor vêm do processo, se não forem indicados.</div>
            </div>
            <div class="col-md-4">
                <label asp-for="Entrada.Armazem" class="form-label"></label>
                <select asp-for="Entrada.Armazem" class="form-select" asp-items="((List<ArmazemStock>)ViewBag.Armazens).Select(a => new SelectListItem(a.Rotulo, a.Codigo))">
                    <option value="">— sem armazém —</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Entrada.Localizacao" class="form-label"></label>
                <input asp-for="Entrada.Localizacao" class="form-control" />
            </div>
            <div class="col-md-8">
                <label asp-for="Entrada.Observacoes" class="form-label"></label>
                <input asp-for="Entrada.Observacoes" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0">Materiais</h5><span class="small text-body-tertiary">Se o código já existir no stock, usa-se esse material. Números de série: separados por espaço ou vírgula.</span></div>
        <div class="card-body table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th style="width:14%">Código</th><th>Descrição</th><th style="width:8%; min-width:5rem">Un.</th><th style="width:10%">Qtd.</th><th style="width:28%">Nºs de série</th><th style="width:3rem"></th></tr></thead>
                <tbody id="linhas-entrada">
                    @for (var i = 0; i < Model.Linhas.Count; i++)
                    {
                        <tr>
                            <td><input asp-for="Linhas[i].Codigo" class="form-control form-control-sm" aria-label="Código" /></td>
                            <td><input asp-for="Linhas[i].Descricao" class="form-control form-control-sm" aria-label="Descrição" /></td>
                            <td><input asp-for="Linhas[i].Unidade" class="form-control form-control-sm" placeholder="PCS" aria-label="Unidade" /></td>
                            <td><input asp-for="Linhas[i].Quantidade" class="form-control form-control-sm text-end" type="text" inputmode="decimal" aria-label="Quantidade" /></td>
                            <td><input asp-for="Linhas[i].Series" class="form-control form-control-sm" aria-label="Números de série" /></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-subtle-danger js-remover-linha" title="Remover linha" aria-label="Remover linha"><i class="fas fa-xmark"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" id="adicionar-linha" class="btn btn-sm btn-subtle-primary mt-2"><span class="fas fa-plus me-1"></span> Adicionar linha</button>
        </div>
    </div>

    <div class="mb-4">
        <button type="submit" class="btn btn-primary"><span class="fas fa-save me-1"></span> Registar entrada</button>
        <a asp-action="Entradas" class="btn btn-subtle-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script>
        // "+ Adicionar linha" copia a última linha (vazia) e renumera os campos Linhas[i].* para o servidor os ler em sequência.
        (function () {
            var corpo = document.getElementById('linhas-entrada');

            function renumerar() {
                corpo.querySelectorAll('tr').forEach(function (tr, i) {
                    tr.querySelectorAll('input').forEach(function (inp) {
                        inp.name = inp.name.replace(/Linhas\[\d+\]/, 'Linhas[' + i + ']');
                        inp.id = inp.id.replace(/Linhas_\d+__/, 'Linhas_' + i + '__');
                    });
                });
            }

            document.getElementById('adicionar-linha').addEventListener('click', function () {
                var modelo = corpo.querySelector('tr:last-child');
                var nova = modelo.cloneNode(true);
                nova.querySelectorAll('input').forEach(function (inp) { inp.value = ''; });
                corpo.appendChild(nova);
                renumerar();
                nova.querySelector('input').focus();
            });

            corpo.addEventListener('click', function (e) {
                var botao = e.target.closest('.js-remover-linha');
                if (!botao) return;
                var tr = botao.closest('tr');
                if (corpo.querySelectorAll('tr').length > 1) {
                    tr.remove();
                    renumerar();
                } else {
                    tr.querySelectorAll('input').forEach(function (inp) { inp.value = ''; }); // a última linha fica, só limpa
                }
            });
        })();
    </script>
}
